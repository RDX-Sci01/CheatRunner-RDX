"    :root {\n"
"      --cr-cool: #82838F;\n"
"      --cr-bg: #050505;\n"
"      --cr-bg-2: #0A0A0B;\n"
"      --cr-bg-3: #111113;\n"
"      --cr-panel: #0D0D10;\n"
"      --cr-panel-2: #151518;\n"
"      --cr-panel-3: #1C1C21;\n"
"      --cr-line: rgba(255,255,255,0.10);\n"
"      --cr-line-strong: rgba(255,255,255,0.18);\n"
"      --cr-brand: #E11D48;\n"
"      --cr-brand-2: #F43F5E;\n"
"      --cr-brand-3: #991B1B;\n"
"      --cr-brand-soft: rgba(225,29,72,0.14);\n"
"      --cr-brand-line: rgba(244,63,94,0.48);\n"
"      --cr-brand-glow: rgba(225,29,72,0.26);\n"
"      --cr-blue: var(--cr-brand);\n"
"      --cr-blue-2: var(--cr-brand-2);\n"
"      --cr-blue-3: var(--cr-brand-3);\n"
"      --cr-blue-soft: var(--cr-brand-soft);\n"
"      --cr-blue-line: var(--cr-brand-line);\n"
"      --cr-blue-glow: var(--cr-brand-glow);\n"
"      --cr-white: #FAFAFA;\n"
"      --cr-white-2: #E7E7EA;\n"
"      --cr-muted: #A1A1AA;\n"
"      --cr-muted-2: #71717A;\n"
"      --cr-red: #EF4444;\n"
"      --cr-yellow: #F59E0B;\n"
"      --cr-green: #22C55E;\n"
"      --cr-green-dark: #15803D;\n"
"      --cr-green-soft: rgba(34,197,94,0.12);\n"
"      --cr-green-border: rgba(34,197,94,0.48);\n"
"      --cr-state-on: #22C55E;\n"
"      --cr-state-on-2: #15803D;\n"
"      --cr-state-on-glow: rgba(34,197,94,0.32);\n"
"      --cr-state-off: #EF4444;\n"
"      --cr-state-off-2: #991B1B;\n"
"      --cr-state-off-glow: rgba(239,68,68,0.32);\n"
"      --cr-switch-border: rgba(255,255,255,0.14);\n"
"      --cr-radius: 14px;\n"
"      --cr-radius-sm: 8px;\n"
"      --cr-radius-lg: 22px;\n"
"      --cr-font-base: Inter, system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif;\n"
"      --cr-font-display: Outfit, Inter, system-ui, sans-serif;\n"
"      --cr-font-mono: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;\n"
"    }\n"
"\n"
"/* ── Reset ───────────────────────────────────────────────── */\n"
"* { box-sizing: border-box; }\n"
"html, body { margin: 0; padding: 0; min-height: 100%; }\n"
"\n"
"body {\n"
"  font-family: var(--cr-font-base);\n"
"  color: var(--cr-white);\n"
"  background: var(--cr-bg);\n"
"  padding: 18px;\n"
"  overflow-x: hidden;\n"
"}\n"
"\n"
"/* ── Background layers ───────────────────────────────────── */\n"
".cr-command-bg {\n"
"  position: fixed;\n"
"  inset: 0;\n"
"  z-index: -3;\n"
"  background:\n"
"    radial-gradient(ellipse 900px 500px at 70% -10%, rgba(234,88,12,0.07) 0%, transparent 60%),\n"
"    radial-gradient(ellipse 600px 400px at -5% 95%,  rgba(234,88,12,0.04) 0%, transparent 55%),\n"
"    linear-gradient(160deg, #0c0c0e 0%, #0f0f14 50%, #0c0c0e 100%);\n"
"}\n"
"\n"
"/* Subtle dot grid — replaces heavy scan-line grid */\n"
".cr-scan-grid {\n"
"  position: fixed;\n"
"  inset: 0;\n"
"  z-index: -2;\n"
"  pointer-events: none;\n"
"  background-image: radial-gradient(circle, rgba(255,255,255,0.06) 1px, transparent 1px);\n"
"  background-size: 28px 28px;\n"
"  mask-image: linear-gradient(to bottom, rgba(0,0,0,0.50) 0%, transparent 80%);\n"
"  -webkit-mask-image: linear-gradient(to bottom, rgba(0,0,0,0.50) 0%, transparent 80%);\n"
"}\n"
"\n"
"/* Circuit lines removed — replaced by dot grid above */\n"
".cr-circuit-lines { display: none; }\n"
"\n"
"/* ── App shell ───────────────────────────────────────────── */\n"
".cr-app-shell {\n"
"  max-width: 1540px;\n"
"  margin: 0 auto;\n"
"  display: grid;\n"
"  grid-template-columns: minmax(0,1fr) 320px;\n"
"  gap: 12px;\n"
"}\n"
"\n"
"    .cr-panel {\n"
"      background: linear-gradient(180deg, var(--cr-panel-2), var(--cr-panel));\n"
"      border: 1px solid var(--cr-line);\n"
"      border-top: 1px solid var(--cr-line-strong);\n"
"      border-radius: var(--cr-radius);\n"
"      box-shadow: 0 8px 32px -8px rgba(0,0,0,0.6);\n"
"      position: relative;\n"
"      overflow: hidden;\n"
"    }\n"
"    .cr-panel::before {\n"
"      content: \"\";\n"
"      position: absolute;\n"
"      top: 0; left: 0; right: 0;\n"
"      height: 1px;\n"
"      background: linear-gradient(90deg, transparent, var(--cr-brand-line), transparent);\n"
"      pointer-events: none;\n"
"      z-index: 1;\n"
"    }\n"
"    .cr-panel::after {\n"
"      content: \"\";\n"
"      position: absolute;\n"
"      top: 5px; left: 5px;\n"
"      width: 7px; height: 7px;\n"
"      border-top: 1px solid var(--cr-brand-2);\n"
"      border-left: 1px solid var(--cr-brand-2);\n"
"      opacity: 0.46;\n"
"      pointer-events: none;\n"
"      z-index: 1;\n"
"    }\n"
"\n"
"    .topbar {\n"
"      grid-column: 1 / -1;\n"
"      padding: 14px;\n"
"      display: flex;\n"
"      align-items: center;\n"
"      justify-content: space-between;\n"
"      gap: 10px;\n"
"      flex-wrap: wrap;\n"
"    }\n"
"    .brand {\n"
"      display: flex;\n"
"      align-items: center;\n"
"      gap: 12px;\n"
"    }\n"
"    .cr-brand-icon {\n"
"      width: 38px;\n"
"      height: 38px;\n"
"      border-radius: 10px;\n"
"      object-fit: cover;\n"
"      flex-shrink: 0;\n"
"      border: 1px solid rgba(244,63,94,0.30);\n"
"      box-shadow: 0 0 18px rgba(225,29,72,0.16);\n"
"      background: #050505;\n"
"    }\n"
"    .brand h1 {\n"
"      margin: 0;\n"
"      font-size: clamp(1.5rem, 2.3vw, 2.2rem);\n"
"      line-height: 1;\n"
"      font-family: var(--cr-font-display);\n"
"      letter-spacing: .01em;\n"
"    }\n"
"    .brand .sub {\n"
"      margin-top: 5px;\n"
"      color: var(--cr-muted);\n"
"      font-size: 15px;\n"
"    }\n"
"    .topbar-right {\n"
"      display: flex;\n"
"      align-items: center;\n"
"      gap: 8px;\n"
"      flex-wrap: wrap;\n"
"    }\n"
"    .cr-support-button {\n"
"      display: inline-flex;\n"
"      align-items: center;\n"
"      justify-content: center;\n"
"      gap: 8px;\n"
"      min-height: 36px;\n"
"      padding: 8px 14px;\n"
"      border-radius: 9999px;\n"
"      font-size: 13px;\n"
"      font-weight: 800;\n"
"      letter-spacing: .02em;\n"
"      cursor: pointer;\n"
"      color: #fff;\n"
"      border: 1px solid rgba(239,68,68,.55);\n"
"      background: rgba(127,29,29,.28);\n"
"      box-shadow: 0 0 18px rgba(239,68,68,.18);\n"
"      transition: transform .18s ease, box-shadow .18s ease, border-color .18s ease, filter .18s ease;\n"
"      white-space: nowrap;\n"
"    }\n"
"    .cr-support-button:hover {\n"
"      transform: translateY(-1px);\n"
"      border-color: rgba(239,68,68,.8);\n"
"      box-shadow: 0 0 28px rgba(239,68,68,.35);\n"
"      filter: brightness(1.12);\n"
"    }\n"
"    .cr-support-button:active { transform: scale(.96); }\n"
"    .cr-discord-button {\n"
"      display: inline-flex;\n"
"      align-items: center;\n"
"      justify-content: center;\n"
"      gap: 8px;\n"
"      min-height: 36px;\n"
"      padding: 8px 14px;\n"
"      border-radius: 9999px;\n"
"      font-size: 13px;\n"
"      font-weight: 800;\n"
"      letter-spacing: .02em;\n"
"      text-decoration: none;\n"
"      color: #fff;\n"
"      border: 1px solid rgba(88,101,242,.55);\n"
"      background: rgba(30,33,108,.35);\n"
"      box-shadow: 0 0 18px rgba(88,101,242,.18);\n"
"      transition: transform .18s ease, box-shadow .18s ease, border-color .18s ease, filter .18s ease;\n"
"      white-space: nowrap;\n"
"    }\n"
"    .cr-discord-button:hover {\n"
"      transform: translateY(-1px);\n"
"      border-color: rgba(88,101,242,.8);\n"
"      box-shadow: 0 0 28px rgba(88,101,242,.38);\n"
"      filter: brightness(1.1);\n"
"    }\n"
"    .cr-discord-button:active { transform: scale(.96); }\n"
"    .cr-x-button {\n"
"      display: inline-flex;\n"
"      align-items: center;\n"
"      justify-content: center;\n"
"      gap: 8px;\n"
"      min-height: 36px;\n"
"      padding: 8px 14px;\n"
"      border-radius: 9999px;\n"
"      font-size: 13px;\n"
"      font-weight: 800;\n"
"      letter-spacing: .02em;\n"
"      text-decoration: none;\n"
"      color: #fff;\n"
"      border: 1px solid rgba(255,255,255,.22);\n"
"      background: linear-gradient(180deg, rgba(24,24,27,.96), rgba(0,0,0,.96));\n"
"      box-shadow: 0 0 18px rgba(0,0,0,.34), inset 0 1px 0 rgba(255,255,255,.08);\n"
"      transition: transform .18s ease, box-shadow .18s ease, border-color .18s ease, filter .18s ease, background .18s ease;\n"
"      white-space: nowrap;\n"
"    }\n"
"    .cr-x-button:hover {\n"
"      transform: translateY(-1px);\n"
"      border-color: rgba(255,255,255,.42);\n"
"      box-shadow: 0 0 24px rgba(255,255,255,.10), 0 0 28px rgba(0,0,0,.46), inset 0 1px 0 rgba(255,255,255,.12);\n"
"      filter: brightness(1.12);\n"
"    }\n"
"    .cr-x-button:active { transform: scale(.96); }\n"
"    .cr-x-icon { width: 16px; height: 16px; flex: 0 0 auto; color: #fff; }\n"
"    .cr-x-label { color: #fff; }\n"
"    .cr-support-modal-overlay {\n"
"      position: fixed; inset: 0; z-index: 200;\n"
"      background: rgba(0,0,0,.72); backdrop-filter: blur(6px);\n"
"      display: flex; align-items: center; justify-content: center;\n"
"    }\n"
"    .cr-support-modal {\n"
"      background: var(--cr-panel-2); border: 1px solid var(--cr-line-strong);\n"
"      border-radius: var(--cr-radius); padding: 32px 28px 24px;\n"
"      max-width: 380px; width: 90%; text-align: center;\n"
"      box-shadow: 0 24px 64px -12px rgba(0,0,0,.7);\n"
"    }\n"
"    .cr-support-modal h2 { margin: 0 0 8px; font-size: 20px; }\n"
"    .cr-support-modal p { margin: 0 0 20px; color: var(--cr-muted); font-size: 14px; line-height: 1.55; }\n"
"    .cr-support-modal .kofi-link {\n"
"      display: inline-flex; align-items: center; gap: 8px;\n"
"      padding: 10px 22px; border-radius: 9999px;\n"
"      font-size: 14px; font-weight: 800; text-decoration: none; color: #fff;\n"
"      border: 1px solid rgba(239,68,68,.55); background: rgba(127,29,29,.28);\n"
"      transition: filter .18s ease, transform .18s ease;\n"
"    }\n"
"    .cr-support-modal .kofi-link:hover { filter: brightness(1.15); transform: translateY(-1px); }\n"
"    .cr-support-modal .modal-close-row { margin-top: 18px; }\n"
"\n"
"/* ── Pills & Badges ──────────────────────────────────────── */\n"
".cr-pill, .badge {\n"
"  display: inline-flex;\n"
"  align-items: center;\n"
"  gap: 5px;\n"
"  border-radius: 9999px;\n"
"  padding: 3px 9px;\n"
"  font-size: 10px;\n"
"  font-family: var(--cr-font-mono);\n"
"  font-weight: 500;\n"
"  text-transform: uppercase;\n"
"  letter-spacing: 0.08em;\n"
"  border: 1px solid var(--cr-line-strong);\n"
"  background: var(--cr-panel-3);\n"
"  color: var(--cr-muted);\n"
"  white-space: nowrap;\n"
"}\n"
".cr-pill.blue, .badge.blue      { color: #f97316; border-color: var(--cr-brand-line); background: var(--cr-brand-soft); }\n"
".cr-pill.green, .badge.green    { color: #4ade80; border-color: var(--cr-green-border); background: var(--cr-green-soft); }\n"
".cr-pill.red, .badge.red        { color: #f87171; border-color: rgba(220,38,38,0.28); background: rgba(220,38,38,0.10); }\n"
".badge.yellow { color: #fbbf24; border-color: rgba(217,119,6,0.28); background: rgba(217,119,6,0.10); }\n"
".badge.gray   { color: var(--cr-muted); border-color: var(--cr-line); background: rgba(255,255,255,0.03); }\n"
"\n"
"/* ── Layout columns ──────────────────────────────────────── */\n"
".main, .side { display: flex; flex-direction: column; gap: 12px; min-width: 0; }\n"
"\n"
"/* ── Card (generic) ──────────────────────────────────────── */\n"
".card {\n"
"  border: 1px solid var(--cr-line-strong);\n"
"  background: var(--cr-panel-2);\n"
"  border-radius: var(--cr-radius);\n"
"  overflow: hidden;\n"
"  transition: border-color 200ms ease;\n"
"}\n"
".small { border-radius: var(--cr-radius); padding: 12px; }\n"
".small h3 {\n"
"  margin: 0 0 10px;\n"
"  font-size: 10px;\n"
"  letter-spacing: 0.12em;\n"
"  text-transform: uppercase;\n"
"  color: var(--cr-muted-2);\n"
"  font-family: var(--cr-font-mono);\n"
"  font-weight: 600;\n"
"}\n"
"\n"
"    .toolbar {\n"
"      display:grid;\n"
"      grid-template-columns: minmax(0,1fr) auto auto auto;\n"
"      gap:10px;\n"
"      padding:12px;\n"
"    }\n"
"    .input, .select {\n"
"      border: 1px solid var(--cr-line);\n"
"      background: rgba(0,0,0,.40);\n"
"      color: var(--cr-white);\n"
"      border-radius: var(--cr-radius-sm);\n"
"      padding: 10px 12px;\n"
"      font-size: .94rem;\n"
"      font-family: var(--cr-font-mono);\n"
"      width:100%;\n"
"      min-width:0;\n"
"    }\n"
"    .input:focus, .select:focus {\n"
"      outline: none;\n"
"      border-color: var(--cr-brand);\n"
"      box-shadow: 0 0 0 1px var(--cr-brand-soft);\n"
"    }\n"
"    .tabs { display:flex; gap:8px; }\n"
"    .tab {\n"
"      border:1px solid var(--cr-line);\n"
"      background: rgba(255,255,255,.03);\n"
"      color: var(--cr-muted);\n"
"      border-radius: var(--cr-radius-sm);\n"
"      padding:8px 11px;\n"
"      font-family: var(--cr-font-mono);\n"
"      font-size:12px;\n"
"      letter-spacing:.08em;\n"
"      text-transform:uppercase;\n"
"      font-weight:800;\n"
"      cursor:pointer;\n"
"      transition: all .18s ease;\n"
"    }\n"
"    .tab.active { color: var(--cr-white); border-color: var(--cr-brand-line); background: var(--cr-brand-soft); }\n"
"\n"
"/* ── Game grid ───────────────────────────────────────────── */\n"
".games {\n"
"  display: grid;\n"
"  grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));\n"
"  gap: 10px;\n"
"  padding: 12px;\n"
"}\n"
"\n"
".cr-game-tile {\n"
"  border-radius: var(--cr-radius);\n"
"  border: 1px solid var(--cr-line-strong);\n"
"  background: var(--cr-panel);\n"
"  padding: 10px;\n"
"  cursor: pointer;\n"
"  transition:\n"
"    transform    0.18s cubic-bezier(0.2,0.8,0.2,1),\n"
"    border-color 0.18s ease;\n"
"  position: relative;\n"
"  overflow: hidden;\n"
"  will-change: transform;\n"
"}\n"
"\n"
"/* Left-edge accent strip — visible only on hover / active states */\n"
".cr-game-tile::before {\n"
"  content: \"\";\n"
"  position: absolute;\n"
"  left: 0; top: 0; bottom: 0;\n"
"  width: 2px;\n"
"  background: transparent;\n"
"  transition: background 0.18s ease;\n"
"}\n"
"\n"
".cr-game-tile:hover {\n"
"  border-color: var(--cr-line-3);\n"
"  transform: translateY(-2px);\n"
"}\n"
".cr-game-tile:hover::before { background: var(--cr-brand-2); }\n"
"\n"
".cr-game-tile.active { border-color: var(--cr-brand-line); }\n"
".cr-game-tile.active::before { background: var(--cr-brand-2); }\n"
"\n"
".cr-game-tile.running { border-color: var(--cr-green-border); }\n"
".cr-game-tile.running::before { background: var(--cr-green); }\n"
"\n"
".cr-game-tile.is-launching {\n"
"  border-color: var(--cr-brand-line);\n"
"  animation: crCardPulse 1.1s ease-in-out infinite;\n"
"}\n"
"\n"
"/* Launch overlay */\n"
".cr-launch-overlay {\n"
"  position: absolute; inset: 0; overflow: hidden;\n"
"  border-radius: var(--cr-radius);\n"
"  background: rgba(5,5,5,0.76);\n"
"  z-index: 4;\n"
"  display: flex; align-items: center; justify-content: center;\n"
"  font-family: var(--cr-font-mono); font-size: 11px;\n"
"  font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase;\n"
"  color: #fed7aa;\n"
"}\n"
".cr-launch-overlay::before {\n"
"  content: \"\";\n"
"  position: absolute; left: 0; right: 0; height: 2px; top: 0;\n"
"  background: linear-gradient(90deg, transparent, rgba(234,88,12,0.80), transparent);\n"
"  animation: crVertScan 0.85s linear infinite;\n"
"  pointer-events: none;\n"
"}\n"
"\n"
".game-cover {\n"
"  width: 100%; aspect-ratio: 1/1;\n"
"  object-fit: cover;\n"
"  border-radius: var(--cr-radius-sm);\n"
"  background: var(--cr-bg-3);\n"
"  border: 1px solid var(--cr-line);\n"
"}\n"
"\n"
".game-name {\n"
"  margin-top: 9px;\n"
"  font-weight: 600;\n"
"  font-family: var(--cr-font-display);\n"
"  font-size: 13px;\n"
"  line-height: 1.3;\n"
"  color: var(--cr-white);\n"
"}\n"
".game-sub {\n"
"  margin-top: 4px;\n"
"  color: var(--cr-muted-2);\n"
"  font-size: 11px;\n"
"  display: flex; justify-content: space-between; gap: 8px;\n"
"  flex-wrap: wrap;\n"
"  font-family: var(--cr-font-mono);\n"
"}\n"
".game-badges { margin-top: 8px; display: flex; gap: 4px; flex-wrap: wrap; }\n"
"\n"
".running-dot {\n"
"  width: 6px; height: 6px;\n"
"  border-radius: 999px;\n"
"  background: var(--cr-green);\n"
"  display: inline-block;\n"
"  animation: crStatusTick 2s infinite;\n"
"}\n"
"\n"
"/* ── Status grid (sidebar) ───────────────────────────────── */\n"
".status-grid { display: grid; grid-template-columns: 1fr; gap: 6px; }\n"
".status-item {\n"
"  border: 1px solid var(--cr-line);\n"
"  border-radius: var(--cr-radius-sm);\n"
"  padding: 9px 11px;\n"
"  background: var(--cr-bg-3);\n"
"  display: flex; align-items: center; justify-content: space-between;\n"
"}\n"
".status-k {\n"
"  color: var(--cr-muted-2); font-size: 11px;\n"
"  text-transform: uppercase; letter-spacing: 0.10em;\n"
"  font-family: var(--cr-font-mono);\n"
"}\n"
".status-v { font-size: 12px; font-family: var(--cr-font-mono); color: var(--cr-white); }\n"
"\n"
"/* ── Logs ────────────────────────────────────────────────── */\n"
".logs-head {\n"
"  display: flex; align-items: center; justify-content: space-between;\n"
"  gap: 10px; margin-bottom: 10px;\n"
"}\n"
".logs-head h3 { margin: 0; }\n"
".logs-actions { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }\n"
"\n"
".cr-logs-console {\n"
"  min-height: 100px; max-height: 220px;\n"
"  overflow: auto;\n"
"  border: 1px solid var(--cr-line-strong);\n"
"  border-left: 2px solid var(--cr-brand-2);\n"
"  border-radius: var(--cr-radius-sm);\n"
"  padding: 10px;\n"
"  background: var(--cr-bg);\n"
"  color: var(--cr-white-2);\n"
"  font-family: var(--cr-font-mono);\n"
"  font-size: 11px;\n"
"  white-space: pre-wrap;\n"
"  word-break: break-word;\n"
"  line-height: 1.6;\n"
"}\n"
".logs-line.info    { color: #b4b4c0; }\n"
".logs-line.warn    { color: #fbbf24; }\n"
".logs-line.error   { color: #f87171; }\n"
".logs-line.success { color: #4ade80; }\n"
"\n"
"/* ── Restart status bar ──────────────────────────────────── */\n"
".restart-status {\n"
"  margin-top: 10px;\n"
"  border: 1px solid var(--cr-line);\n"
"  border-radius: var(--cr-radius-sm);\n"
"  padding: 10px;\n"
"  background: rgba(0,0,0,0.25);\n"
"  color: var(--cr-muted);\n"
"  font-family: var(--cr-font-mono);\n"
"  font-size: 11px;\n"
"  line-height: 1.45;\n"
"  display: none;\n"
"  white-space: pre-line;\n"
"}\n"
".restart-status.info    { border-color: var(--cr-brand-line); color: #fed7aa; }\n"
".restart-status.error   { border-color: rgba(220,38,38,0.40); color: #fecaca; }\n"
".restart-status.success { border-color: var(--cr-green-border); color: #bbf7d0; }\n"
"\n"
"/* ── Trainer overlay ─────────────────────────────────────── */\n"
".cr-trainer-overlay {\n"
"  position: fixed; inset: 0; z-index: 99999;\n"
"  display: none; align-items: center; justify-content: center;\n"
"  padding: 14px;\n"
"  background: rgba(5,5,5,0.85);\n"
"}\n"
".cr-trainer-overlay.show { display: flex; }\n"
"\n"
".cr-trainer-console {\n"
"  width: min(700px, 100%);\n"
"  max-height: 85vh;\n"
"  display: flex; flex-direction: column;\n"
"  overflow: hidden;\n"
"  background: var(--cr-panel);\n"
"  border: 1px solid var(--cr-line-strong);\n"
"  border-left: 3px solid var(--cr-brand-2);\n"
"  border-radius: var(--cr-radius-lg);\n"
"  box-shadow: 0 40px 80px rgba(0,0,0,0.80);\n"
"  animation: crPanelDeploy 0.22s cubic-bezier(0.16,1,0.3,1);\n"
"}\n"
".cr-trainer-console::before {\n"
"  content: \"Trainer Console\";\n"
"  display: block;\n"
"  padding: 4px 12px;\n"
"  font-family: var(--cr-font-mono);\n"
"  font-size: 10px;\n"
"  letter-spacing: 0.14em;\n"
"  text-transform: uppercase;\n"
"  color: #f97316;\n"
"  background: var(--cr-brand-soft);\n"
"  border-bottom: 1px solid var(--cr-brand-line);\n"
"}\n"
"\n"
".modal-header {\n"
"  display: flex; justify-content: space-between;\n"
"  align-items: flex-start; gap: 10px;\n"
"  padding: 14px 16px;\n"
"  border-bottom: 1px solid var(--cr-line);\n"
"}\n"
".modal-title {\n"
"  margin: 0;\n"
"  font-size: clamp(1.1rem, 2.2vw, 1.5rem);\n"
"  font-family: var(--cr-font-display);\n"
"  font-weight: 600; line-height: 1.2;\n"
"}\n"
".modal-sub { margin-top: 5px; color: var(--cr-muted-2); font-family: var(--cr-font-mono); font-size: 11px; }\n"
"\n"
".xbtn {\n"
"  width: 32px; height: 32px;\n"
"  border-radius: 999px;\n"
"  border: 1px solid var(--cr-line-strong);\n"
"  background: var(--cr-panel-2);\n"
"  color: var(--cr-white);\n"
"  cursor: pointer;\n"
"  flex: 0 0 auto;\n"
"  display: flex; align-items: center; justify-content: center;\n"
"  transition: background 0.15s;\n"
"}\n"
".xbtn:hover { background: var(--cr-panel-3); }\n"
"\n"
".modal-body {\n"
"  flex: 1; overflow: auto;\n"
"  padding: 14px; display: grid; gap: 10px;\n"
"  background: var(--cr-bg-2);\n"
"}\n"
".modal-footer {\n"
"  display: flex; justify-content: space-between;\n"
"  gap: 10px; flex-wrap: wrap;\n"
"  padding: 12px 16px;\n"
"  border-top: 1px solid var(--cr-line);\n"
"  background: var(--cr-panel);\n"
"}\n"
"\n"
"/* ── Cheat info / empty ──────────────────────────────────── */\n"
".cheat-info {\n"
"  border: 1px solid var(--cr-brand-line);\n"
"  border-left: 2px solid var(--cr-brand-2);\n"
"  border-radius: var(--cr-radius-sm);\n"
"  background: var(--cr-brand-soft);\n"
"  padding: 10px;\n"
"  font-family: var(--cr-font-mono);\n"
"  font-size: 12px;\n"
"  color: var(--cr-white-2);\n"
"}\n"
".cheat-empty {\n"
"  border: 1px dashed var(--cr-brand-line);\n"
"  border-radius: var(--cr-radius);\n"
"  background: var(--cr-brand-soft);\n"
"  padding: 16px;\n"
"  color: var(--cr-muted);\n"
"  font-family: var(--cr-font-mono);\n"
"  font-size: 12px;\n"
"}\n"
"\n"
".cr-cheat-dropzone {\n"
"  border: 1.5px dashed var(--cr-line-strong);\n"
"  border-radius: var(--cr-radius-sm);\n"
"  padding: 12px 16px;\n"
"  text-align: center;\n"
"  color: var(--cr-muted-2);\n"
"  font-family: var(--cr-font-mono);\n"
"  font-size: 11px;\n"
"  letter-spacing: 0.04em;\n"
"  cursor: pointer;\n"
"  transition: border-color 0.15s, background 0.15s, color 0.15s;\n"
"}\n"
".cr-cheat-dropzone:hover,\n"
".cr-cheat-dropzone.drag-over {\n"
"  border-color: var(--cr-brand-2);\n"
"  background: var(--cr-brand-soft);\n"
"  color: var(--cr-white-2);\n"
"}\n"
"\n"
"/* ── Modal tabs ──────────────────────────────────────────── */\n"
".cr-modal-tabs  { display: flex; gap: 6px; flex-wrap: wrap; }\n"
".cr-modal-tab {\n"
"  min-height: 32px; padding: 6px 14px;\n"
"  border-radius: 999px;\n"
"  border: 1px solid var(--cr-line-strong);\n"
"  background: var(--cr-panel-2);\n"
"  color: var(--cr-muted-2);\n"
"  font-size: 12px; font-weight: 500; cursor: pointer;\n"
"  transition: all 0.15s;\n"
"}\n"
".cr-modal-tab.active { color: #f97316; border-color: var(--cr-brand-line); background: var(--cr-brand-soft); }\n"
"\n"
".cr-modal-panel { display: grid; gap: 10px; }\n"
"\n"
"/* Source list */\n"
".cr-source-list  { display: grid; gap: 8px; }\n"
".cr-source-item  {\n"
"  border: 1px solid var(--cr-line-strong);\n"
"  border-radius: var(--cr-radius-sm);\n"
"  background: var(--cr-panel-2);\n"
"  padding: 10px 12px;\n"
"  display: grid; gap: 8px;\n"
"}\n"
".cr-source-main  { display: flex; justify-content: space-between; gap: 10px; align-items: center; flex-wrap: wrap; }\n"
".cr-source-name  { font-weight: 600; font-size: 12px; color: var(--cr-white-2); }\n"
".cr-source-meta  { font-size: 11px; color: var(--cr-muted-2); font-family: var(--cr-font-mono); word-break: break-word; }\n"
".cr-source-actions { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; }\n"
".cr-panel-note   { font-size: 11px; color: var(--cr-muted-2); font-family: var(--cr-font-mono); }\n"
"\n"
"    .cr-cheat-row {\n"
"      display: grid;\n"
"      grid-template-columns: 1fr auto;\n"
"      align-items: center;\n"
"      gap: 16px;\n"
"      min-height: 58px;\n"
"      padding: 12px 14px 12px 18px;\n"
"      border-radius: var(--cr-radius-sm);\n"
"      border: 1px solid transparent;\n"
"      border-left: 3px solid transparent;\n"
"      background: var(--cr-panel-2);\n"
"      transition:\n"
"        background 200ms ease,\n"
"        border-color 180ms ease,\n"
"        box-shadow 200ms ease,\n"
"        opacity 180ms ease;\n"
"    }\n"
"    .cr-cheat-row.is-off {\n"
"      border-color: var(--cr-line);\n"
"      border-left-color: var(--cr-muted-2);\n"
"    }\n"
"    .cr-cheat-row.is-off:hover { border-left-color: var(--cr-brand); }\n"
"    .cr-cheat-row.is-on {\n"
"      background: linear-gradient(90deg, var(--cr-green-soft), rgba(3,7,18,0.80));\n"
"      border-color: var(--cr-green-border);\n"
"      border-left-color: var(--cr-green);\n"
"      box-shadow: 0 0 18px rgba(34,197,94,0.12);\n"
"    }\n"
"    .cr-cheat-row.is-error {\n"
"      background: rgba(239,68,68,.08);\n"
"      border-color: rgba(239,68,68,.35);\n"
"      border-left-color: var(--cr-red);\n"
"    }\n"
"    .cr-cheat-row.is-mixed {\n"
"      background: linear-gradient(90deg, rgba(245,158,11,0.08), rgba(3,7,18,0.80));\n"
"      border-color: rgba(245,158,11,0.38);\n"
"      border-left-color: var(--cr-yellow);\n"
"      box-shadow: 0 0 18px rgba(245,158,11,0.10);\n"
"    }\n"
"    .cr-cheat-row.is-unknown {\n"
"      border-color: var(--cr-line);\n"
"      border-left-color: var(--cr-muted-2);\n"
"    }\n"
"    .cr-cheat-row.is-applying {\n"
"      opacity: .68;\n"
"      pointer-events: none;\n"
"      position: relative;\n"
"      overflow: hidden;\n"
"    }\n"
"    .cr-cheat-row.is-applying::after {\n"
"      content: \"\";\n"
"      position: absolute;\n"
"      inset: 0;\n"
"      background: linear-gradient(90deg, transparent, rgba(244,63,94,.10), transparent);\n"
"      animation: crScanSweep .9s linear infinite;\n"
"      pointer-events: none;\n"
"      z-index: 2;\n"
"    }\n"
"    #cheatMods.cr-mods-appear .cr-cheat-row { animation: crRowReveal .20s ease both; }\n"
"    #cheatMods.cr-mods-appear .cr-cheat-row:nth-child(2) { animation-delay: .04s; }\n"
"    #cheatMods.cr-mods-appear .cr-cheat-row:nth-child(3) { animation-delay: .08s; }\n"
"    #cheatMods.cr-mods-appear .cr-cheat-row:nth-child(4) { animation-delay: .12s; }\n"
"    #cheatMods.cr-mods-appear .cr-cheat-row:nth-child(5) { animation-delay: .16s; }\n"
"    #cheatMods.cr-mods-appear .cr-cheat-row:nth-child(n+6) { animation-delay: .20s; }\n"
"    .cr-cheat-main {\n"
"      display: flex;\n"
"      flex-direction: column;\n"
"      gap: 3px;\n"
"    }\n"
"    .cr-cheat-name {\n"
"      font-family: var(--cr-font-display);\n"
"      font-weight: 900;\n"
"      font-size: 15px;\n"
"      line-height: 1.2;\n"
"      color: var(--cr-white);\n"
"    }\n"
"    .cr-cheat-title {\n"
"      font-family: var(--cr-font-display);\n"
"      font-weight: 800;\n"
"      font-size: 15px;\n"
"      line-height: 1.2;\n"
"      color: var(--cr-white);\n"
"    }\n"
"    .cr-cheat-row.is-on .cr-cheat-name,\n"
"    .cr-cheat-row.is-on .cr-cheat-title { color: #bbf7d0; }\n"
"    .cr-cheat-row.is-mixed .cr-cheat-name,\n"
"    .cr-cheat-row.is-mixed .cr-cheat-title { color: #fde68a; }\n"
"    .cr-cheat-status-chip {\n"
"      display: inline-block;\n"
"      font-size: 10px;\n"
"      font-weight: 700;\n"
"      font-family: var(--cr-font-display);\n"
"      letter-spacing: .04em;\n"
"      padding: 1px 6px;\n"
"      border-radius: 4px;\n"
"      line-height: 1.5;\n"
"    }\n"
"    .cr-chip-error {\n"
"      background: rgba(239,68,68,.18);\n"
"      color: #fca5a5;\n"
"      border: 1px solid rgba(239,68,68,.35);\n"
"    }\n"
"    .cr-chip-mixed {\n"
"      background: rgba(245,158,11,.18);\n"
"      color: #fde68a;\n"
"      border: 1px solid rgba(245,158,11,.35);\n"
"    }\n"
"\n"
"    .cr-warn-banner {\n"
"      display: flex;\n"
"      align-items: flex-start;\n"
"      gap: 8px;\n"
"      padding: 8px 12px;\n"
"      margin-bottom: 8px;\n"
"      background: rgba(245,158,11,0.10);\n"
"      border: 1px solid rgba(245,158,11,0.40);\n"
"      border-radius: var(--cr-radius-sm);\n"
"      color: #F59E0B;\n"
"      font-size: 12px;\n"
"      line-height: 1.5;\n"
"    }\n"
"\n"
"    .cr-settings-content { margin-top: 8px; }\n"
"    .cr-settings-group { margin-bottom: 16px; }\n"
"    .cr-settings-group-title { font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; color: var(--cr-muted); margin-bottom: 6px; }\n"
"    .cr-settings-row { display: flex; align-items: flex-start; justify-content: space-between; padding: 8px 0; border-bottom: 1px solid var(--cr-line); gap: 12px; }\n"
"    .cr-settings-row:last-child { border-bottom: none; }\n"
"    .cr-settings-label-wrap { flex: 1; min-width: 0; }\n"
"    .cr-settings-label { font-size: 13px; }\n"
"    .cr-settings-hint { font-size: 11px; color: var(--cr-muted-2); margin-top: 2px; }\n"
"    .cr-settings-ctrl { flex: 0 0 auto; }\n"
"    .cr-settings-select, .cr-settings-num { background: var(--cr-panel-3); border: 1px solid var(--cr-line-strong); color: var(--cr-white); border-radius: 6px; padding: 4px 8px; font-size: 12px; }\n"
"    .cr-settings-num { width: 90px; text-align: right; }\n"
"    .cr-addr-mode-row { display: flex; align-items: center; gap: 6px; padding: 6px 0; flex-wrap: wrap; margin-bottom: 4px; }\n"
"    .btn.active { background: var(--cr-brand); color: #fff; border-color: var(--cr-brand); }\n"
"\n"
"    .cr-chip-conflict {\n"
"      display: inline-block;\n"
"      font-size: 10px;\n"
"      font-weight: 700;\n"
"      letter-spacing: 0.06em;\n"
"      padding: 2px 7px;\n"
"      border-radius: 20px;\n"
"      background: rgba(245,158,11,0.15);\n"
"      color: #F59E0B;\n"
"      border: 1px solid rgba(245,158,11,0.40);\n"
"      margin-top: 3px;\n"
"      max-width: 100%;\n"
"      overflow: hidden;\n"
"      text-overflow: ellipsis;\n"
"      white-space: nowrap;\n"
"    }\n"
"    .cr-cheat-row.is-conflict .cr-cheat-switch:not(.is-on) .cr-cheat-switch-fill { background: rgba(245,158,11,0.22); }\n"
"\n"
"    .cr-cheat-switch {\n"
"      position: relative;\n"
"      width: 108px;\n"
"      height: 36px;\n"
"      padding: 0;\n"
"      border: 0;\n"
"      background: transparent;\n"
"      cursor: pointer;\n"
"      flex: 0 0 auto;\n"
"      -webkit-tap-highlight-color: transparent;\n"
"    }\n"
"    .cr-cheat-switch-track {\n"
"      position: relative;\n"
"      display: grid;\n"
"      grid-template-columns: 1fr 1fr;\n"
"      align-items: center;\n"
"      width: 100%;\n"
"      height: 100%;\n"
"      border-radius: 999px;\n"
"      overflow: hidden;\n"
"      background: linear-gradient(180deg, rgba(15,23,42,0.98), rgba(2,6,23,0.98));\n"
"      border: 1px solid var(--cr-switch-border);\n"
"      box-shadow:\n"
"        inset 0 1px 0 rgba(255,255,255,0.06),\n"
"        inset 0 -1px 0 rgba(0,0,0,0.32),\n"
"        0 8px 20px rgba(0,0,0,0.30);\n"
"    }\n"
"    .cr-cheat-switch-fill {\n"
"      position: absolute;\n"
"      top: 3px;\n"
"      left: 3px;\n"
"      width: calc(50% - 3px);\n"
"      height: calc(100% - 6px);\n"
"      border-radius: 999px;\n"
"      z-index: 1;\n"
"      background: linear-gradient(180deg, var(--cr-state-off), var(--cr-state-off-2));\n"
"      box-shadow: 0 0 16px var(--cr-state-off-glow), inset 0 1px 0 rgba(255,255,255,0.20);\n"
"      transform: translateX(0);\n"
"      transition:\n"
"        transform .22s cubic-bezier(.2,.8,.2,1),\n"
"        background .18s ease,\n"
"        box-shadow .18s ease,\n"
"        filter .14s ease;\n"
"    }\n"
"    .cr-cheat-switch.is-on .cr-cheat-switch-fill {\n"
"      transform: translateX(calc(100% - 3px));\n"
"      background: linear-gradient(180deg, var(--cr-state-on), var(--cr-state-on-2));\n"
"      box-shadow: 0 0 18px var(--cr-state-on-glow), inset 0 1px 0 rgba(255,255,255,0.22);\n"
"    }\n"
"    .cr-cheat-switch-label {\n"
"      position: relative;\n"
"      z-index: 2;\n"
"      font-family: var(--cr-font-mono);\n"
"      font-size: 10px;\n"
"      font-weight: 900;\n"
"      letter-spacing: .10em;\n"
"      text-align: center;\n"
"      text-transform: uppercase;\n"
"      color: rgba(255,255,255,0.42);\n"
"      user-select: none;\n"
"      pointer-events: none;\n"
"      transition: color .18s ease, text-shadow .18s ease;\n"
"    }\n"
"    .cr-cheat-switch.is-off .cr-cheat-switch-label-off { color: #fff; text-shadow: 0 0 8px rgba(255,255,255,0.22); }\n"
"    .cr-cheat-switch.is-on .cr-cheat-switch-label-on { color: #fff; text-shadow: 0 0 8px rgba(255,255,255,0.22); }\n"
"    .cr-cheat-switch:hover .cr-cheat-switch-track { border-color: rgba(255,255,255,0.22); }\n"
"    .cr-cheat-switch:active .cr-cheat-switch-fill { filter: brightness(1.12); }\n"
"    .cr-cheat-switch:disabled { opacity: .45; cursor: not-allowed; }\n"
"    .cr-cheat-switch:focus-visible { outline: 2px solid rgba(255,255,255,0.70); outline-offset: 3px; }\n"
"    .cr-cheat-switch.is-pending { pointer-events: none; }\n"
"    .cr-cheat-switch.is-pending .cr-cheat-switch-track::after {\n"
"      content: '';\n"
"      position: absolute;\n"
"      inset: 0;\n"
"      z-index: 4;\n"
"      background: linear-gradient(90deg, transparent, rgba(255,255,255,0.18), transparent);\n"
"      transform: translateX(-100%);\n"
"      animation: crSwitchScan .75s linear infinite;\n"
"    }\n"
"    @keyframes crSwitchScan { to { transform: translateX(100%); } }\n"
"    .cr-cheat-switch {\n"
"      transition:\n"
"        transform 180ms ease,\n"
"        filter 180ms ease,\n"
"        opacity 180ms ease;\n"
"      will-change: transform;\n"
"    }\n"
"    .cr-cheat-switch:hover:not(:disabled):not(.is-applying) { transform: translateY(-1px); }\n"
"    .cr-cheat-switch:hover:not(:disabled):not(.is-applying) .cr-cheat-switch-track {\n"
"      border-color: rgba(255,255,255,0.26);\n"
"      box-shadow:\n"
"        inset 0 1px 0 rgba(255,255,255,0.08),\n"
"        inset 0 -1px 0 rgba(0,0,0,0.32),\n"
"        0 10px 26px rgba(0,0,0,0.34);\n"
"    }\n"
"    .cr-cheat-switch:active:not(:disabled):not(.is-applying) { transform: scale(0.97); }\n"
"    .cr-cheat-switch.is-on .cr-cheat-switch-track {\n"
"      box-shadow:\n"
"        inset 0 1px 0 rgba(255,255,255,0.06),\n"
"        inset 0 -1px 0 rgba(0,0,0,0.32),\n"
"        0 8px 20px rgba(0,0,0,0.30),\n"
"        0 0 16px var(--cr-state-on-glow);\n"
"    }\n"
"    .cr-cheat-switch.is-error .cr-cheat-switch-fill {\n"
"      background: linear-gradient(180deg, #F97316, #7C2D12);\n"
"      box-shadow: 0 0 14px rgba(249,115,22,0.40), inset 0 1px 0 rgba(255,255,255,0.20);\n"
"    }\n"
"    .cr-cheat-switch.is-mixed .cr-cheat-switch-fill {\n"
"      background: linear-gradient(180deg, var(--cr-yellow), #B45309);\n"
"      box-shadow: 0 0 14px rgba(245,158,11,0.38), inset 0 1px 0 rgba(255,255,255,0.20);\n"
"    }\n"
"    .cr-cheat-switch.is-applying {\n"
"      cursor: progress !important;\n"
"      pointer-events: none;\n"
"      opacity: 0.78;\n"
"    }\n"
"    .cr-cheat-switch.is-applying .cr-cheat-switch-track::after {\n"
"      content: '';\n"
"      position: absolute;\n"
"      inset: 0;\n"
"      z-index: 4;\n"
"      border-radius: inherit;\n"
"      background: linear-gradient(90deg, transparent, rgba(255,255,255,.20), transparent);\n"
"      transform: translateX(-100%);\n"
"      animation: crSwitchScan .75s linear infinite;\n"
"      pointer-events: none;\n"
"    }\n"
"    @media (prefers-reduced-motion: reduce) {\n"
"      .cr-cheat-switch,\n"
"      .cr-cheat-switch-track,\n"
"      .cr-cheat-switch-fill,\n"
"      .cr-cheat-switch *,\n"
"      .cr-cheat-row,\n"
"      .cr-cand-row,\n"
"      .cr-game-tile,\n"
"      .card,\n"
"      .btn,\n"
"      .cr-btn,\n"
"      .kofi-link,\n"
"      .cr-support-button,\n"
"      .cr-discord-button,\n"
"      .cr-x-button { transition: none !important; animation: none !important; }\n"
"    }\n"
"\n"
"/* ── Candidate selector ──────────────────────────────────── */\n"
"#cheatCandidates { margin: 6px 0 10px 0; }\n"
".cr-cand-list { display: flex; flex-direction: column; gap: 5px; }\n"
".cr-cand-row {\n"
"  display: flex; align-items: center; gap: 8px;\n"
"  padding: 8px 12px;\n"
"  border-radius: var(--cr-radius-sm);\n"
"  background: rgba(255,255,255,0.02);\n"
"  border: 1px solid var(--cr-line);\n"
"  border-left: 2px solid transparent;\n"
"  font-size: 12px;\n"
"  transition:\n"
"    transform    150ms cubic-bezier(0.2,0.8,0.2,1),\n"
"    border-color 160ms ease,\n"
"    background   160ms ease;\n"
"  will-change: transform;\n"
"}\n"
".cr-cand-row:hover { transform: translateY(-1px); }\n"
".cr-cand-row.is-selected {\n"
"  border-color: var(--cr-green-border);\n"
"  border-left-color: var(--cr-green);\n"
"  background: var(--cr-green-soft);\n"
"}\n"
".cr-cand-row.is-wrong-ver {\n"
"  border-color: rgba(217,119,6,0.25);\n"
"  border-left-color: var(--cr-yellow);\n"
"  background: rgba(217,119,6,0.05);\n"
"}\n"
"\n"
".cr-cand-fname    { flex: 1; font-family: var(--cr-font-mono); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: var(--cr-white-2); }\n"
".cr-cand-meta     { font-size: 10px; color: var(--cr-muted-2); font-family: var(--cr-font-mono); white-space: nowrap; }\n"
".cr-cand-badge    { font-size: 10px; font-weight: 600; letter-spacing: 0.05em; text-transform: uppercase; padding: 2px 7px; border-radius: 4px; white-space: nowrap; }\n"
".cr-cand-badge.fmt     { background: rgba(100,130,200,0.16); color: #93c5fd; border: 1px solid rgba(100,130,200,0.22); }\n"
".cr-cand-badge.exact   { background: var(--cr-green-soft); color: #86efac; border: 1px solid var(--cr-green-border); }\n"
".cr-cand-badge.generic { background: rgba(150,150,150,0.14); color: #a1a1aa; border: 1px solid rgba(150,150,150,0.20); }\n"
".cr-cand-badge.wrong   { background: rgba(217,119,6,0.16); color: #fcd34d; border: 1px solid rgba(217,119,6,0.28); }\n"
".cr-cand-badge.selected { background: rgba(22,163,74,0.22); color: #86efac; border: 1px solid var(--cr-green-border); }\n"
".cr-cand-badge.manual  { background: rgba(130,100,200,0.20); color: #c4b5fd; border: 1px solid rgba(130,100,200,0.30); }\n"
".cr-cand-select-btn { font-size: 11px; padding: 3px 10px; flex-shrink: 0; }\n"
".cr-cand-auto-btn   { font-size: 11px; padding: 3px 10px; flex-shrink: 0; background: rgba(130,100,200,0.16); }\n"
"\n"
"/* ── Toast ───────────────────────────────────────────────── */\n"
".toast {\n"
"  position: fixed;\n"
"  right: 16px; top: 16px;\n"
"  z-index: 100000;\n"
"  border: 1px solid var(--cr-line-strong);\n"
"  border-left: 2px solid var(--cr-brand-2);\n"
"  background: var(--cr-panel-2);\n"
"  color: var(--cr-white);\n"
"  border-radius: var(--cr-radius-sm);\n"
"  padding: 10px 14px;\n"
"  max-width: min(90vw, 360px);\n"
"  font-family: var(--cr-font-mono);\n"
"  font-size: 12px;\n"
"  opacity: 0;\n"
"  pointer-events: none;\n"
"}\n"
".toast.show   { animation: crToastIn 0.22s cubic-bezier(0.16,1,0.3,1) forwards; }\n"
".toast.info   { border-left-color: var(--cr-brand-2); background: var(--cr-brand-soft); }\n"
".toast.success { border-left-color: var(--cr-green); background: var(--cr-green-soft); color: #bbf7d0; }\n"
".toast.warn   { border-left-color: var(--cr-yellow); background: rgba(217,119,6,0.09); color: #fde68a; }\n"
".toast.error  { border-left-color: var(--cr-red); background: rgba(220,38,38,0.10); color: #fca5a5; }\n"
"\n"
"    .muted { color: var(--cr-muted); font-size: 13px; }\n"
"\n"
"    @keyframes crLineReveal { from { transform: scaleX(0); opacity:0; } to { transform: scaleX(1); opacity:1; } }\n"
"    @keyframes crPanelDeploy { from { opacity:0; transform: translateY(18px); clip-path: inset(8px 0 0 0 round 14px); } to { opacity:1; transform: translateY(0); clip-path: inset(0px round 14px); } }\n"
"    @keyframes crScanSweep { from { transform: translateX(-120%); } to { transform: translateX(120%); } }\n"
"    @keyframes crStatusTick { 0%,100% { opacity:1; } 50% { opacity:.35; } }\n"
"    @keyframes crToastSnap { from { opacity:0; transform: translateY(-8px); clip-path: inset(0 0 100% 0); } to { opacity:1; transform: translateY(0); clip-path: inset(0 0 0% 0); } }\n"
"    @keyframes crToastIn { from { opacity:0; transform: translateY(-6px) scale(.97); clip-path: inset(0 0 100% 0); } to { opacity:1; transform: translateY(0) scale(1); clip-path: inset(0 0 0% 0); } }\n"
"    @keyframes crCardPulse { 0%,100% { border-left-color: var(--cr-brand); box-shadow: 0 0 0 1px rgba(225,29,72,.14); } 50% { border-left-color: var(--cr-brand-2); box-shadow: 0 0 28px rgba(225,29,72,.30), 0 0 0 2px rgba(244,63,94,.18); } }\n"
"    @keyframes crVertScan { 0% { top: -4px; opacity: 1; } 100% { top: 100%; opacity: .4; } }\n"
"    @keyframes crModalScan { from { transform: translateY(-100%); opacity: .9; } to { transform: translateY(160%); opacity: 0; } }\n"
"    @keyframes crRowReveal { from { opacity:0; transform: translateY(7px); } to { opacity:1; transform: translateY(0); } }\n"
"\n"
"    :focus-visible {\n"
"      outline: 2px solid rgba(244,63,94,.68);\n"
"      outline-offset: 3px;\n"
"    }\n"
"    ::-webkit-scrollbar { width:6px; height:6px; }\n"
"    ::-webkit-scrollbar-track { background: transparent; }\n"
"    ::-webkit-scrollbar-thumb { background: rgba(255,255,255,.10); border-radius:10px; }\n"
"    ::-webkit-scrollbar-thumb:hover { background: rgba(244,63,94,.58); }\n"
"\n"
"    @media (max-width:1200px) { .cr-app-shell { grid-template-columns:1fr; } .side { order:2; } }\n"
"    @media (max-width:768px) {\n"
"      body { padding:12px; }\n"
"      .toolbar { grid-template-columns:1fr; }\n"
"      .tabs { overflow:auto; }\n"
"      .modal-footer { justify-content: stretch; }\n"
"      .modal-footer .btn { flex: 1 1 180px; }\n"
"      .topbar { padding: 12px; }\n"
"    }\n"
"    @media (max-width:640px) {\n"
"      .cr-support-button, .cr-discord-button, .cr-x-button { padding: 0; width: 36px; min-height: 36px; }\n"
"      .cr-support-label, .cr-discord-label, .cr-x-label { display: none; }\n"
"    }\n"
"\n"
"    /* --- Mod search bar --- */\n"
"    .cr-mod-search { font-size:.85rem; height:36px; padding:8px 12px; }\n"
"    .cr-mod-search:focus { border-color:var(--cr-brand); box-shadow:0 0 0 1px var(--cr-brand-soft); }\n"
"\n"
"    /* --- Modal stats bar --- */\n"
"    .cr-modal-stats { display:flex; align-items:center; gap:6px; margin-top:6px; flex-wrap:wrap; }\n"
"    .cr-stat-pill {\n"
"      display:inline-flex; align-items:center; gap:4px;\n"
"      font-family:var(--cr-font-mono); font-size:10px; font-weight:700;\n"
"      letter-spacing:.08em; text-transform:uppercase;\n"
"      padding:2px 8px; border-radius:999px;\n"
"      border:1px solid var(--cr-line); background:rgba(255,255,255,.04); color:var(--cr-muted);\n"
"    }\n"
"    .cr-stat-pill.active { color:#86efac; border-color:rgba(34,197,94,.40); background:rgba(34,197,94,.10); }\n"
"    .cr-stat-pill.warn   { color:#fde68a; border-color:rgba(245,158,11,.40); background:rgba(245,158,11,.10); }\n"
"\n"
"    /* --- Mod type group headers --- */\n"
"    .cr-mod-group { display:grid; gap:6px; }\n"
"    .cr-mod-groups { display:grid; gap:12px; }\n"
"    .cr-mod-group-header {\n"
"      font-family:var(--cr-font-mono); font-size:10px; font-weight:700;\n"
"      letter-spacing:.12em; text-transform:uppercase; color:var(--cr-muted-2);\n"
"      padding:4px 0 4px 0; border-bottom:1px solid var(--cr-line);\n"
"    }\n"
"\n"
"    /* --- Cheat description --- */\n"
"    .cr-cheat-desc {\n"
"      font-size:11px; color:var(--cr-muted); font-family:var(--cr-font-base);\n"
"      line-height:1.4; margin-top:2px;\n"
"      display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden;\n"
"    }\n"
"    .cr-cheat-row.is-on .cr-cheat-desc { color:rgba(187,247,208,.60); }\n"
"\n"
"    /* --- Inline reason for error states --- */\n"
"    .cr-cheat-reason {\n"
"      font-size:10px; font-family:var(--cr-font-mono); color:var(--cr-muted);\n"
"      margin-top:2px; line-height:1.35;\n"
"    }\n"
"    .cr-cheat-row.is-error .cr-cheat-reason  { color:#fca5a5; }\n"
"    .cr-cheat-row.is-mixed .cr-cheat-reason  { color:#fde68a; }\n"
"\n"
"    /* --- Setup / health panel --- */\n"
"    .cr-health-items { display:grid; gap:6px; }\n"
"    .cr-health-item {\n"
"      display:flex; align-items:center; gap:8px; font-size:12px;\n"
"      padding:6px 8px; border-radius:var(--cr-radius-sm);\n"
"      background:rgba(0,0,0,.20); border:1px solid var(--cr-line);\n"
"    }\n"
"    .cr-health-dot {\n"
"      width:8px; height:8px; border-radius:999px; flex-shrink:0;\n"
"      background:var(--cr-muted-2);\n"
"    }\n"
"    .cr-health-dot.ok   { background:var(--cr-green); box-shadow:0 0 6px rgba(34,197,94,.5); }\n"
"    .cr-health-dot.warn { background:var(--cr-yellow); }\n"
"    .cr-health-dot.err  { background:var(--cr-red); }\n"
"    .cr-health-label { flex:1; color:var(--cr-muted); }\n"
"    .cr-health-val { font-family:var(--cr-font-mono); font-size:11px; color:var(--cr-white-2); }\n"
"\n"
"    /* --- First-run onboarding panel --- */\n"
"    .cr-onboard {\n"
"      border:1px dashed var(--cr-brand-line); border-radius:var(--cr-radius);\n"
"      background:var(--cr-brand-soft); padding:22px 18px; display:grid; gap:14px;\n"
"    }\n"
"    .cr-onboard-title {\n"
"      font-family:var(--cr-font-display); font-size:1.05rem;\n"
"      font-weight:900; color:var(--cr-white);\n"
"    }\n"
"    .cr-onboard-subtitle { font-size:13px; color:var(--cr-muted); margin-top:-6px; }\n"
"    .cr-onboard-steps { display:grid; gap:8px; }\n"
"    .cr-onboard-step { display:flex; gap:10px; align-items:flex-start; font-size:13px; color:var(--cr-muted); }\n"
"    .cr-onboard-num {\n"
"      width:20px; height:20px; border-radius:999px;\n"
"      background:var(--cr-brand-soft); border:1px solid var(--cr-brand-line);\n"
"      font-size:10px; font-weight:900; font-family:var(--cr-font-mono); color:var(--cr-brand-2);\n"
"      display:flex; align-items:center; justify-content:center; flex-shrink:0;\n"
"    }\n"
"    .cr-onboard-actions { display:flex; gap:8px; flex-wrap:wrap; }\n"
"\n"
"    /* --- Patch entries --- */\n"
"    .cr-patch-info { font-size:12px; color:var(--cr-muted); font-family:var(--cr-font-mono); margin-bottom:8px; line-height:1.5; }\n"
"    .cr-patch-list { display:grid; gap:8px; }\n"
"    .cr-patch-row {\n"
"      display:flex; align-items:flex-start; gap:12px;\n"
"      padding:12px 14px; border-radius:var(--cr-radius-sm);\n"
"      border:1px solid var(--cr-line); border-left:3px solid transparent;\n"
"      background:var(--cr-panel-2);\n"
"      transition:border-color .18s ease, background .18s ease;\n"
"    }\n"
"    .cr-patch-row.ver-match  { border-left-color:var(--cr-green); }\n"
"    .cr-patch-row.ver-miss   { border-left-color:var(--cr-muted-2); opacity:.6; }\n"
"    .cr-patch-row.ver-mask   { border-left-color:var(--cr-brand); }\n"
"    .cr-patch-row.is-applied { background:linear-gradient(90deg,var(--cr-green-soft),rgba(3,7,18,.8)); border-color:var(--cr-green-border); border-left-color:var(--cr-green); }\n"
"    .cr-patch-body { flex:1; min-width:0; }\n"
"    .cr-patch-name { font-family:var(--cr-font-display); font-weight:800; font-size:14px; color:var(--cr-white); }\n"
"    .cr-patch-row.is-applied .cr-patch-name { color:#bbf7d0; }\n"
"    .cr-patch-meta { font-size:11px; color:var(--cr-muted); font-family:var(--cr-font-mono); margin-top:3px; }\n"
"    .cr-patch-note { font-size:11px; color:var(--cr-muted-2); margin-top:4px; font-style:italic; }\n"
"    .cr-patch-ver { display:inline-flex; align-items:center; gap:4px; font-size:10px; font-family:var(--cr-font-mono); font-weight:700; padding:2px 7px; border-radius:4px; margin-top:4px; }\n"
"    .cr-patch-ver.match { background:rgba(34,197,94,.15); color:#86efac; border:1px solid rgba(34,197,94,.35); }\n"
"    .cr-patch-ver.miss  { background:rgba(239,68,68,.10); color:#fca5a5; border:1px solid rgba(239,68,68,.30); }\n"
"    .cr-patch-ver.mask  { background:var(--cr-brand-soft); color:#ffe4e6; border:1px solid var(--cr-brand-line); }\n"
"    .cr-patch-ver.unk   { background:rgba(255,255,255,.04); color:var(--cr-muted); border:1px solid var(--cr-line); }\n"
"    .cr-patch-unsup { font-size:10px; color:var(--cr-yellow); margin-top:4px; }\n"
"    .cr-patch-action { flex-shrink:0; }\n"
"    .cr-patch-applied-chip { display:inline-flex; align-items:center; gap:4px; padding:6px 10px; border-radius:var(--cr-radius-sm); background:rgba(34,197,94,.18); color:#86efac; border:1px solid rgba(34,197,94,.40); font-size:11px; font-weight:700; font-family:var(--cr-font-mono); }\n"
"\n"
"    /* ---- Settings: gear button + top-level overlay ---- */\n"
"    .cr-gear-button { display:inline-flex; align-items:center; gap:8px; min-height:36px; padding:8px 14px; border-radius:9999px; font-size:13px; font-weight:800; letter-spacing:.02em; color:#fff; cursor:pointer; border:1px solid var(--cr-line-strong); background:var(--cr-panel-2); transition:transform .18s ease, border-color .18s ease, filter .18s ease; white-space:nowrap; }\n"
"    .cr-gear-button:hover { transform:translateY(-1px); border-color:var(--cr-brand-line); filter:brightness(1.12); }\n"
"    .cr-gear-button:active { transform:scale(.96); }\n"
"    .cr-settings-overlay { position:fixed; inset:0; z-index:200; background:rgba(0,0,0,.72); backdrop-filter:blur(6px); align-items:center; justify-content:center; padding:14px; }\n"
"    .cr-settings-console { width:min(640px,100%); max-height:88vh; display:flex; flex-direction:column; overflow:hidden; background:var(--cr-panel); border:1px solid var(--cr-line-strong); border-left:4px solid var(--cr-brand); border-radius:var(--cr-radius); box-shadow:0 40px 80px rgba(0,0,0,.85), 0 0 40px var(--cr-brand-glow); animation: crPanelDeploy .24s cubic-bezier(.16,1,.3,1); }\n"
"    .cr-settings-search-wrap { padding:10px 16px 0; }\n"
"    .cr-settings-search-wrap .input { width:100%; }\n"
"    /* presets */\n"
"    .cr-preset-row { display:flex; gap:10px; flex-wrap:wrap; }\n"
"    .cr-preset-card { flex:1 1 150px; text-align:left; cursor:pointer; padding:12px; border-radius:var(--cr-radius-sm); border:1px solid var(--cr-line-strong); background:var(--cr-panel-3); color:var(--cr-white); transition:border-color .15s ease, transform .15s ease, box-shadow .15s ease; }\n"
"    .cr-preset-card:hover { border-color:var(--cr-brand-line); transform:translateY(-1px); box-shadow:0 0 16px var(--cr-brand-glow); }\n"
"    .cr-preset-card:active { transform:scale(.98); }\n"
"    .cr-preset-title { font-weight:800; font-size:13px; margin-bottom:4px; }\n"
"    .cr-preset-desc { font-size:11px; color:var(--cr-muted); line-height:1.4; }\n"
"    /* setting badges */\n"
"    .cr-set-badge { display:inline-block; margin-left:8px; padding:1px 7px; border-radius:9999px; font-size:9px; font-weight:800; letter-spacing:.04em; text-transform:uppercase; vertical-align:middle; }\n"
"    .cr-set-badge.rec { background:var(--cr-green-soft); color:#86efac; border:1px solid var(--cr-green-border); }\n"
"    .cr-set-badge.risk { background:rgba(239,68,68,.14); color:#fca5a5; border:1px solid rgba(239,68,68,.40); }\n"
"    .cr-set-badge.mod { background:var(--cr-brand-soft); color:var(--cr-brand-2); border:1px solid var(--cr-brand-line); }\n"
"    @media (max-width:560px) {\n"
"      .cr-settings-row { flex-direction:column; align-items:stretch; }\n"
"      .cr-settings-ctrl { align-self:flex-start; }\n"
"      .cr-gear-label { display:none; }\n"
"    }\n"
"\n"
"    /* ---- Themes (data-theme on <html>; 'dark' is the :root baseline) ---- */\n"
"    html[data-theme=\"crimson\"] { --cr-brand:#FB1D4A; --cr-brand-2:#FF4D6D; --cr-bg:#0A0304; --cr-bg-2:#120406; --cr-bg-3:#180609; --cr-panel:#140609; --cr-panel-2:#1B080C; --cr-panel-3:#240B10; }\n"
"    html[data-theme=\"midnight\"] { --cr-brand:#3B82F6; --cr-brand-2:#60A5FA; --cr-brand-3:#1E40AF; --cr-brand-soft:rgba(59,130,246,.14); --cr-brand-line:rgba(96,165,250,.48); --cr-brand-glow:rgba(59,130,246,.26); --cr-bg:#04060A; --cr-bg-2:#070A12; --cr-bg-3:#0C111B; --cr-panel:#0A0E16; --cr-panel-2:#10151F; --cr-panel-3:#161D2A; }\n"
"\n"
"    /* ---- Favorites star on game tiles ---- */\n"
"    .cr-game-tile { position: relative; }\n"
"    .cr-fav-btn { position:absolute; top:8px; right:8px; z-index:5; width:30px; height:30px; border-radius:9999px; border:1px solid var(--cr-line-strong); background:rgba(5,5,5,.55); color:var(--cr-muted); font-size:15px; line-height:1; cursor:pointer; display:flex; align-items:center; justify-content:center; transition:transform .15s ease, color .15s ease, border-color .15s ease; }\n"
"    .cr-fav-btn:hover { transform:scale(1.12); color:var(--cr-yellow); border-color:var(--cr-yellow); }\n"
"    .cr-fav-btn.is-fav { color:var(--cr-yellow); border-color:rgba(245,158,11,.5); background:rgba(245,158,11,.14); }\n"
"\n"
"    /* ---- First-run onboarding ---- */\n"
"    .cr-onboard-step { padding:10px 0; border-bottom:1px solid var(--cr-line); }\n"
"    .cr-onboard-step:last-child { border-bottom:none; }\n"
"    .cr-onboard-step-title { font-size:12px; font-weight:800; text-transform:uppercase; letter-spacing:.08em; color:var(--cr-brand-2); margin-bottom:8px; }\n"
"    .cr-onboard-note { font-size:12px; color:var(--cr-muted); line-height:1.5; margin-top:8px; }\n"
"    .cr-onboard-note code { font-family:var(--cr-font-mono); font-size:11px; background:var(--cr-panel-3); padding:1px 5px; border-radius:4px; }\n"
"    .cr-preset-card.cr-preset-selected { border-color:var(--cr-brand); box-shadow:0 0 0 1px var(--cr-brand) inset, 0 0 16px var(--cr-brand-glow); }\n"
