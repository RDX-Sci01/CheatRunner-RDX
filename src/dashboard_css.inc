"/*\n"
"  CommandRun — Tailwind CSS Theme\n"
"  ================================\n"
"  Requires Tailwind CSS v3+ and the tailwind.config.js\n"
"  in this same directory (or merged into your project config).\n"
"\n"
"  Add to your HTML <head>:\n"
"    <link rel=\"stylesheet\" href=\"theme.tailwind.css\">\n"
"  Or import into your entry CSS:\n"
"    @import \"theme.tailwind.css\";\n"
"\n"
"  All original class names are preserved — no HTML changes needed.\n"
"*/\n"
"\n"
"@tailwind base;\n"
"@tailwind components;\n"
"@tailwind utilities;\n"
"\n"
"/* ── Base layer ──────────────────────────────────────────── */\n"
"@layer base {\n"
"  *, *::before, *::after {\n"
"    @apply box-border;\n"
"  }\n"
"\n"
"  html, body {\n"
"    @apply m-0 p-0 min-h-full;\n"
"  }\n"
"\n"
"  body {\n"
"    @apply font-sans overflow-x-hidden p-[18px];\n"
"    color: #f0f0f4;\n"
"    background: #0c0c0e;\n"
"  }\n"
"\n"
"  :focus-visible {\n"
"    outline: 2px solid rgba(234,88,12,0.65);\n"
"    outline-offset: 3px;\n"
"  }\n"
"\n"
"  /* Scrollbar */\n"
"  ::-webkit-scrollbar       { @apply w-[5px] h-[5px]; }\n"
"  ::-webkit-scrollbar-track { @apply bg-transparent; }\n"
"  ::-webkit-scrollbar-thumb {\n"
"    background: rgba(255,255,255,0.08);\n"
"    @apply rounded-[10px];\n"
"  }\n"
"  ::-webkit-scrollbar-thumb:hover { background: rgba(234,88,12,0.50); }\n"
"\n"
"  @media (prefers-reduced-motion: reduce) {\n"
"    .cr-cheat-switch,\n"
"    .cr-cheat-switch-track,\n"
"    .cr-cheat-switch-fill,\n"
"    .cr-cheat-switch *,\n"
"    .cr-cheat-row,\n"
"    .cr-cand-row,\n"
"    .cr-game-tile,\n"
"    .card,\n"
"    .btn,\n"
"    .cr-btn,\n"
"    .cr-support-button,\n"
"    .cr-discord-button,\n"
"    .cr-x-button {\n"
"      transition: none !important;\n"
"      animation: none !important;\n"
"    }\n"
"  }\n"
"}\n"
"\n"
"/* ── Component layer ─────────────────────────────────────── */\n"
"@layer components {\n"
"\n"
"  /* ── Background layers ─────────────────────────────────── */\n"
"  .cr-command-bg {\n"
"    @apply fixed inset-0 -z-[3] pointer-events-none;\n"
"    background:\n"
"      radial-gradient(ellipse 900px 500px at 70% -10%, rgba(234,88,12,0.07) 0%, transparent 60%),\n"
"      radial-gradient(ellipse 600px 400px at -5% 95%,  rgba(234,88,12,0.04) 0%, transparent 55%),\n"
"      linear-gradient(160deg, #0c0c0e 0%, #0f0f14 50%, #0c0c0e 100%);\n"
"  }\n"
"\n"
"  .cr-scan-grid {\n"
"    @apply fixed inset-0 -z-[2] pointer-events-none;\n"
"    background-image: radial-gradient(circle, rgba(255,255,255,0.06) 1px, transparent 1px);\n"
"    background-size: 28px 28px;\n"
"    mask-image: linear-gradient(to bottom, rgba(0,0,0,0.50) 0%, transparent 80%);\n"
"    -webkit-mask-image: linear-gradient(to bottom, rgba(0,0,0,0.50) 0%, transparent 80%);\n"
"  }\n"
"\n"
"  .cr-circuit-lines { @apply hidden; }\n"
"\n"
"  /* ── App shell ─────────────────────────────────────────── */\n"
"  .cr-app-shell {\n"
"    @apply max-w-[1540px] mx-auto grid gap-3;\n"
"    grid-template-columns: minmax(0,1fr) 320px;\n"
"  }\n"
"\n"
"  /* ── Panel base ────────────────────────────────────────── */\n"
"  .cr-panel {\n"
"    @apply relative overflow-hidden rounded-[14px];\n"
"    background: #19191f;\n"
"    border: 1px solid rgba(255,255,255,0.12);\n"
"    box-shadow: 0 4px 24px -6px rgba(0,0,0,0.5);\n"
"  }\n"
"  /* Top shimmer */\n"
"  .cr-panel::before {\n"
"    @apply content-[''] absolute top-0 left-0 right-0 h-px pointer-events-none z-[1];\n"
"    background: linear-gradient(\n"
"      90deg,\n"
"      transparent 0%,\n"
"      rgba(255,255,255,0.08) 40%,\n"
"      rgba(255,255,255,0.04) 60%,\n"
"      transparent 100%\n"
"    );\n"
"  }\n"
"  .cr-panel::after { @apply hidden; }\n"
"\n"
"  /* ── Topbar ────────────────────────────────────────────── */\n"
"  .topbar {\n"
"    @apply col-span-full flex items-center justify-between gap-2.5 flex-wrap px-4 py-3.5;\n"
"  }\n"
"\n"
"  .brand          { @apply flex items-center gap-3; }\n"
"\n"
"  .cr-brand-icon {\n"
"    @apply w-9 h-9 rounded-[9px] flex items-center justify-center flex-shrink-0;\n"
"    background: linear-gradient(135deg, #c2410c, #9a3412);\n"
"    border: 1px solid rgba(234,88,12,0.30);\n"
"  }\n"
"\n"
"  .brand h1 {\n"
"    @apply m-0 font-sans font-semibold leading-none tracking-tight;\n"
"    font-size: clamp(1.1rem, 2vw, 1.3rem);\n"
"    color: #f0f0f4;\n"
"  }\n"
"\n"
"  .brand .sub {\n"
"    @apply mt-[3px] font-mono text-[11px];\n"
"    color: #78788a;\n"
"  }\n"
"\n"
"  .topbar-right { @apply flex items-center gap-2 flex-wrap; }\n"
"\n"
"  /* ── Buttons ───────────────────────────────────────────── */\n"
"  .cr-btn,\n"
"  .btn {\n"
"    @apply inline-flex items-center justify-center gap-1.5\n"
"           rounded-[6px] px-3.5 py-[7px]\n"
"           text-xs font-medium font-mono tracking-[0.02em]\n"
"           cursor-pointer whitespace-nowrap no-underline\n"
"           relative overflow-hidden transition-all duration-150;\n"
"    border: 1px solid rgba(255,255,255,0.12);\n"
"    background: #1f1f28;\n"
"    color: #b4b4c0;\n"
"    will-change: transform;\n"
"  }\n"
"  .cr-btn::before,\n"
"  .btn::before { @apply hidden; }\n"
"\n"
"  .cr-btn:hover:not(:disabled),\n"
"  .btn:hover:not(:disabled) {\n"
"    border-color: rgba(255,255,255,0.18);\n"
"    color: #f0f0f4;\n"
"    background: #222230;\n"
"    @apply -translate-y-px;\n"
"  }\n"
"  .cr-btn:active:not(:disabled),\n"
"  .btn:active:not(:disabled) { @apply scale-[0.97]; }\n"
"\n"
"  .btn.ghost {\n"
"    @apply bg-transparent;\n"
"    border-color: rgba(255,255,255,0.07);\n"
"  }\n"
"  .btn.ghost:hover { background: #1f1f28; border-color: rgba(255,255,255,0.12); }\n"
"\n"
"  .btn.primary,\n"
"  .btn[data-launch] {\n"
"    background: linear-gradient(135deg, #ea580c 0%, #9a3412 100%);\n"
"    border-color: rgba(234,88,12,0.30);\n"
"    @apply text-white;\n"
"  }\n"
"  .btn.primary:hover:not(:disabled),\n"
"  .btn[data-launch]:hover:not(:disabled) { @apply brightness-110; }\n"
"\n"
"  .btn.secondary { border-color: rgba(255,255,255,0.07); background: rgba(255,255,255,0.03); color: #f0f0f4; }\n"
"  .btn.danger    { background: rgba(220,38,38,0.10); border-color: rgba(220,38,38,0.28); color: #f87171; }\n"
"  .btn.compact   { @apply px-2.5 py-[5px] text-[11px] rounded-[6px]; }\n"
"\n"
"  /* Social topbar buttons */\n"
"  .cr-support-button {\n"
"    @apply inline-flex items-center justify-center gap-2 rounded-full\n"
"           px-3.5 py-[7px] text-xs font-medium font-mono whitespace-nowrap\n"
"           text-white cursor-pointer transition-all duration-150;\n"
"    border: 1px solid rgba(220,38,38,0.35);\n"
"    background: rgba(127,29,29,0.20);\n"
"  }\n"
"  .cr-support-button:hover { border-color: rgba(220,38,38,0.60); @apply -translate-y-px; }\n"
"  .cr-support-button:active { @apply scale-[0.97]; }\n"
"\n"
"  .cr-discord-button {\n"
"    @apply inline-flex items-center justify-center gap-2 rounded-full\n"
"           px-3.5 py-[7px] text-xs font-medium font-mono whitespace-nowrap\n"
"           no-underline text-white cursor-pointer transition-all duration-150;\n"
"    border: 1px solid rgba(88,101,242,0.35);\n"
"    background: rgba(30,33,108,0.25);\n"
"  }\n"
"  .cr-discord-button:hover { border-color: rgba(88,101,242,0.65); @apply -translate-y-px brightness-110; }\n"
"  .cr-discord-button:active { @apply scale-[0.97]; }\n"
"\n"
"  .cr-x-button {\n"
"    @apply inline-flex items-center justify-center gap-2 rounded-full\n"
"           px-3.5 py-[7px] text-xs font-medium font-mono whitespace-nowrap\n"
"           no-underline text-white cursor-pointer transition-all duration-150;\n"
"    border: 1px solid rgba(255,255,255,0.16);\n"
"    background: rgba(24,24,27,0.80);\n"
"  }\n"
"  .cr-x-button:hover { border-color: rgba(255,255,255,0.32); @apply -translate-y-px brightness-110; }\n"
"  .cr-x-button:active { @apply scale-[0.97]; }\n"
"\n"
"  /* Support modal */\n"
"  .cr-support-modal-overlay {\n"
"    @apply fixed inset-0 z-[200] flex items-center justify-center;\n"
"    background: rgba(0,0,0,0.70);\n"
"    backdrop-filter: blur(6px);\n"
"  }\n"
"  .cr-support-modal {\n"
"    @apply rounded-[14px] p-7 text-center w-[90%] max-w-[360px];\n"
"    background: #19191f;\n"
"    border: 1px solid rgba(255,255,255,0.12);\n"
"    box-shadow: 0 24px 56px -12px rgba(0,0,0,0.65);\n"
"  }\n"
"  .cr-support-modal h2   { @apply m-0 mb-2 text-lg font-semibold; }\n"
"  .cr-support-modal p    { @apply m-0 mb-4 text-sm leading-relaxed; color: #a1a1aa; }\n"
"  .cr-support-modal .kofi-link {\n"
"    @apply inline-flex items-center gap-2 rounded-full px-5 py-2.5\n"
"           text-sm font-semibold no-underline text-white transition-all duration-150;\n"
"    border: 1px solid rgba(220,38,38,0.40);\n"
"    background: rgba(127,29,29,0.22);\n"
"  }\n"
"  .cr-support-modal .kofi-link:hover { @apply brightness-110 -translate-y-px; }\n"
"  .cr-support-modal .modal-close-row { @apply mt-4; }\n"
"\n"
"  /* ── Pills & Badges ────────────────────────────────────── */\n"
"  .cr-pill,\n"
"  .badge {\n"
"    @apply inline-flex items-center gap-[5px] rounded-full\n"
"           px-[9px] py-[3px] text-[10px] font-mono font-medium\n"
"           uppercase tracking-[0.08em] whitespace-nowrap;\n"
"    border: 1px solid rgba(255,255,255,0.12);\n"
"    background: #1f1f28;\n"
"    color: #a1a1aa;\n"
"  }\n"
"  .cr-pill.blue,\n"
"  .badge.blue    { color: #f97316; border-color: rgba(234,88,12,0.30); background: rgba(234,88,12,0.10); }\n"
"  .cr-pill.green,\n"
"  .badge.green   { color: #4ade80; border-color: rgba(22,163,74,0.28);  background: rgba(22,163,74,0.10); }\n"
"  .cr-pill.red,\n"
"  .badge.red     { color: #f87171; border-color: rgba(220,38,38,0.28);  background: rgba(220,38,38,0.10); }\n"
"  .badge.yellow  { color: #fbbf24; border-color: rgba(217,119,6,0.28);  background: rgba(217,119,6,0.10); }\n"
"  .badge.gray    { color: #a1a1aa; border-color: rgba(255,255,255,0.07); background: rgba(255,255,255,0.03); }\n"
"\n"
"  /* ── Layout ────────────────────────────────────────────── */\n"
"  .main,\n"
"  .side { @apply flex flex-col gap-3 min-w-0; }\n"
"\n"
"  .card {\n"
"    @apply overflow-hidden rounded-[10px] transition-colors duration-200;\n"
"    border: 1px solid rgba(255,255,255,0.12);\n"
"    background: #19191f;\n"
"  }\n"
"  .small { @apply rounded-[10px] p-3; }\n"
"  .small h3 {\n"
"    @apply m-0 mb-2.5 font-mono text-[10px] font-semibold uppercase tracking-[0.12em];\n"
"    color: #78788a;\n"
"  }\n"
"\n"
"  /* ── Toolbar ───────────────────────────────────────────── */\n"
"  .toolbar {\n"
"    @apply grid gap-2 p-3;\n"
"    grid-template-columns: minmax(0,1fr) auto auto auto;\n"
"  }\n"
"\n"
"  .input,\n"
"  .select {\n"
"    @apply w-full min-w-0 rounded-[6px] px-[11px] py-2 font-mono text-[13px]\n"
"           transition-colors duration-150;\n"
"    border: 1px solid rgba(255,255,255,0.12);\n"
"    background: #16161d;\n"
"    color: #f0f0f4;\n"
"  }\n"
"  .input:focus,\n"
"  .select:focus { @apply outline-none; border-color: #ea580c; }\n"
"  .input::placeholder { color: #78788a; }\n"
"\n"
"  .tabs      { @apply flex gap-1; }\n"
"  .tab {\n"
"    @apply border border-transparent bg-transparent rounded-[6px]\n"
"           px-3 py-1.5 font-mono text-[11px] font-medium uppercase tracking-[0.07em]\n"
"           cursor-pointer transition-all duration-150;\n"
"    color: #78788a;\n"
"  }\n"
"  .tab:hover  { color: #b4b4c0; background: #1f1f28; }\n"
"  .tab.active { color: #f97316; border-color: rgba(234,88,12,0.30); background: rgba(234,88,12,0.10); }\n"
"\n"
"  /* ── Game grid ─────────────────────────────────────────── */\n"
"  .games {\n"
"    @apply grid gap-2.5 p-3;\n"
"    grid-template-columns: repeat(auto-fill, minmax(200px,1fr));\n"
"  }\n"
"\n"
"  .cr-game-tile {\n"
"    @apply relative overflow-hidden rounded-[10px] p-2.5 cursor-pointer\n"
"           transition-all duration-[180ms];\n"
"    border: 1px solid rgba(255,255,255,0.12);\n"
"    background: #13131a;\n"
"    will-change: transform;\n"
"  }\n"
"  /* Left edge accent strip */\n"
"  .cr-game-tile::before {\n"
"    @apply content-[''] absolute left-0 top-0 bottom-0 w-0.5;\n"
"    background: transparent;\n"
"    transition: background 0.18s ease;\n"
"  }\n"
"  .cr-game-tile:hover               { border-color: rgba(255,255,255,0.18); @apply -translate-y-0.5; }\n"
"  .cr-game-tile:hover::before       { background: #ea580c; }\n"
"  .cr-game-tile.active              { border-color: rgba(234,88,12,0.30); }\n"
"  .cr-game-tile.active::before      { background: #ea580c; }\n"
"  .cr-game-tile.running             { border-color: rgba(22,163,74,0.28); }\n"
"  .cr-game-tile.running::before     { background: #16a34a; }\n"
"  .cr-game-tile.is-launching        { border-color: rgba(234,88,12,0.30); @apply animate-[crCardPulse_1.1s_ease-in-out_infinite]; }\n"
"\n"
"  .cr-launch-overlay {\n"
"    @apply absolute inset-0 overflow-hidden rounded-[10px] z-[4]\n"
"           flex items-center justify-center\n"
"           font-mono text-[11px] font-bold uppercase tracking-[0.12em];\n"
"    background: rgba(5,5,5,0.76);\n"
"    color: #fed7aa;\n"
"  }\n"
"  .cr-launch-overlay::before {\n"
"    @apply content-[''] absolute left-0 right-0 h-0.5 top-0 pointer-events-none;\n"
"    background: linear-gradient(90deg, transparent, rgba(234,88,12,0.80), transparent);\n"
"    animation: crVertScan 0.85s linear infinite;\n"
"  }\n"
"\n"
"  .game-cover {\n"
"    @apply w-full object-cover rounded-[6px];\n"
"    aspect-ratio: 1/1;\n"
"    background: #16161d;\n"
"    border: 1px solid rgba(255,255,255,0.07);\n"
"  }\n"
"  .game-name  { @apply mt-[9px] font-sans font-semibold text-[13px] leading-snug; color: #f0f0f4; }\n"
"  .game-sub   {\n"
"    @apply mt-1 flex justify-between gap-2 flex-wrap font-mono text-[11px];\n"
"    color: #78788a;\n"
"  }\n"
"  .game-badges { @apply mt-2 flex gap-1 flex-wrap; }\n"
"\n"
"  .running-dot {\n"
"    @apply inline-block w-1.5 h-1.5 rounded-full;\n"
"    background: #16a34a;\n"
"    animation: crStatusTick 2s infinite;\n"
"  }\n"
"\n"
"  /* ── Status grid ───────────────────────────────────────── */\n"
"  .status-grid { @apply grid gap-1.5; grid-template-columns: 1fr; }\n"
"  .status-item {\n"
"    @apply flex items-center justify-between rounded-[6px] px-[11px] py-[9px];\n"
"    border: 1px solid rgba(255,255,255,0.07);\n"
"    background: #16161d;\n"
"  }\n"
"  .status-k {\n"
"    @apply font-mono text-[11px] uppercase tracking-[0.10em];\n"
"    color: #78788a;\n"
"  }\n"
"  .status-v { @apply font-mono text-xs font-medium; color: #f0f0f4; }\n"
"\n"
"  /* ── Logs ──────────────────────────────────────────────── */\n"
"  .logs-head { @apply flex items-center justify-between gap-2.5 mb-2.5; }\n"
"  .logs-head h3 { @apply m-0; }\n"
"  .logs-actions { @apply flex items-center gap-2 flex-wrap; }\n"
"\n"
"  .cr-logs-console {\n"
"    @apply overflow-auto rounded-[6px] p-2.5 font-mono text-[11px]\n"
"           whitespace-pre-wrap break-words leading-relaxed;\n"
"    min-height: 100px; max-height: 220px;\n"
"    border: 1px solid rgba(255,255,255,0.12);\n"
"    border-left: 2px solid #ea580c;\n"
"    background: #0c0c0e;\n"
"    color: #b4b4c0;\n"
"  }\n"
"  .logs-line.info    { color: #b4b4c0; }\n"
"  .logs-line.warn    { color: #fbbf24; }\n"
"  .logs-line.error   { color: #f87171; }\n"
"  .logs-line.success { color: #4ade80; }\n"
"\n"
"  /* ── Restart status ────────────────────────────────────── */\n"
"  .restart-status {\n"
"    @apply hidden mt-2.5 rounded-[6px] p-2.5 font-mono text-[11px] leading-snug whitespace-pre-line;\n"
"    border: 1px solid rgba(255,255,255,0.07);\n"
"    background: rgba(0,0,0,0.25);\n"
"    color: #a1a1aa;\n"
"  }\n"
"  .restart-status.info    { border-color: rgba(234,88,12,0.30); color: #fed7aa; }\n"
"  .restart-status.error   { border-color: rgba(220,38,38,0.40); color: #fecaca; }\n"
"  .restart-status.success { border-color: rgba(22,163,74,0.28);  color: #bbf7d0; }\n"
"\n"
"  /* ── Trainer overlay ───────────────────────────────────── */\n"
"  .cr-trainer-overlay {\n"
"    @apply fixed inset-0 z-[99999] hidden items-center justify-center p-3.5;\n"
"    background: rgba(5,5,5,0.85);\n"
"  }\n"
"  .cr-trainer-overlay.show { @apply flex; }\n"
"\n"
"  .cr-trainer-console {\n"
"    @apply flex flex-col overflow-hidden rounded-[14px];\n"
"    width: min(700px,100%); max-height: 85vh;\n"
"    background: #13131a;\n"
"    border: 1px solid rgba(255,255,255,0.12);\n"
"    border-left: 3px solid #ea580c;\n"
"    box-shadow: 0 40px 80px rgba(0,0,0,0.80);\n"
"    animation: crPanelDeploy 0.22s cubic-bezier(0.16,1,0.3,1);\n"
"  }\n"
"  .cr-trainer-console::before {\n"
"    @apply block px-3 py-1 font-mono text-[10px] uppercase tracking-[0.14em];\n"
"    content: \"Trainer Console\";\n"
"    color: #f97316;\n"
"    background: rgba(234,88,12,0.10);\n"
"    border-bottom: 1px solid rgba(234,88,12,0.30);\n"
"  }\n"
"\n"
"  .modal-header {\n"
"    @apply flex justify-between items-start gap-2.5 px-4 py-3.5;\n"
"    border-bottom: 1px solid rgba(255,255,255,0.07);\n"
"  }\n"
"  .modal-title {\n"
"    @apply m-0 font-sans font-semibold leading-tight;\n"
"    font-size: clamp(1.1rem,2.2vw,1.5rem);\n"
"  }\n"
"  .modal-sub { @apply mt-[5px] font-mono text-[11px]; color: #78788a; }\n"
"\n"
"  .xbtn {\n"
"    @apply w-8 h-8 rounded-full flex items-center justify-center flex-shrink-0\n"
"           cursor-pointer transition-colors duration-150;\n"
"    border: 1px solid rgba(255,255,255,0.12);\n"
"    background: #19191f;\n"
"    color: #f0f0f4;\n"
"  }\n"
"  .xbtn:hover { background: #1f1f28; }\n"
"\n"
"  .modal-body {\n"
"    @apply flex-1 overflow-auto p-3.5 grid gap-2.5;\n"
"    background: #111116;\n"
"  }\n"
"  .modal-footer {\n"
"    @apply flex justify-between gap-2.5 flex-wrap px-4 py-3;\n"
"    border-top: 1px solid rgba(255,255,255,0.07);\n"
"    background: #13131a;\n"
"  }\n"
"\n"
"  /* ── Cheat info / empty ────────────────────────────────── */\n"
"  .cheat-info {\n"
"    @apply rounded-[6px] p-2.5 font-mono text-[12px];\n"
"    border: 1px solid rgba(234,88,12,0.30);\n"
"    border-left: 2px solid #ea580c;\n"
"    background: rgba(234,88,12,0.10);\n"
"    color: #b4b4c0;\n"
"  }\n"
"  .cheat-empty {\n"
"    @apply rounded-[10px] p-4 font-mono text-xs;\n"
"    border: 1px dashed rgba(234,88,12,0.30);\n"
"    background: rgba(234,88,12,0.10);\n"
"    color: #a1a1aa;\n"
"  }\n"
"\n"
"  .cr-cheat-dropzone {\n"
"    @apply rounded-[6px] px-4 py-3 text-center font-mono text-[11px] tracking-[0.04em]\n"
"           cursor-pointer transition-all duration-150;\n"
"    border: 1.5px dashed rgba(255,255,255,0.12);\n"
"    color: #78788a;\n"
"  }\n"
"  .cr-cheat-dropzone:hover,\n"
"  .cr-cheat-dropzone.drag-over {\n"
"    border-color: #ea580c;\n"
"    background: rgba(234,88,12,0.10);\n"
"    color: #b4b4c0;\n"
"  }\n"
"\n"
"  /* ── Modal tabs ────────────────────────────────────────── */\n"
"  .cr-modal-tabs  { @apply flex gap-1.5 flex-wrap; }\n"
"  .cr-modal-tab {\n"
"    @apply min-h-[32px] px-3.5 py-1.5 rounded-full text-xs font-medium cursor-pointer\n"
"           transition-all duration-150;\n"
"    border: 1px solid rgba(255,255,255,0.12);\n"
"    background: #19191f;\n"
"    color: #78788a;\n"
"  }\n"
"  .cr-modal-tab.active { color: #f97316; border-color: rgba(234,88,12,0.30); background: rgba(234,88,12,0.10); }\n"
"  .cr-modal-panel { @apply grid gap-2.5; }\n"
"\n"
"  /* Source list */\n"
"  .cr-source-list  { @apply grid gap-2; }\n"
"  .cr-source-item  {\n"
"    @apply grid gap-2 rounded-[6px] px-3 py-2.5;\n"
"    border: 1px solid rgba(255,255,255,0.12);\n"
"    background: #19191f;\n"
"  }\n"
"  .cr-source-main  { @apply flex justify-between gap-2.5 items-center flex-wrap; }\n"
"  .cr-source-name  { @apply font-semibold text-xs; color: #b4b4c0; }\n"
"  .cr-source-meta  { @apply font-mono text-[11px] break-words; color: #78788a; }\n"
"  .cr-source-actions { @apply flex gap-2 flex-wrap items-center; }\n"
"  .cr-panel-note   { @apply font-mono text-[11px]; color: #78788a; }\n"
"\n"
"  /* ── Cheat rows ────────────────────────────────────────── */\n"
"  .cr-cheat-row {\n"
"    @apply grid items-center gap-4 min-h-[56px] px-3.5 py-[11px] rounded-[6px]\n"
"           transition-all duration-200;\n"
"    grid-template-columns: 1fr auto;\n"
"    border: 1px solid rgba(255,255,255,0.12);\n"
"    border-left: 2px solid transparent;\n"
"    background: #19191f;\n"
"  }\n"
"  .cr-cheat-row.is-off         { border-left-color: #78788a; }\n"
"  .cr-cheat-row.is-off:hover   { border-left-color: #ea580c; }\n"
"  .cr-cheat-row.is-on {\n"
"    background: linear-gradient(90deg, rgba(22,163,74,0.10), rgba(13,13,16,0.80));\n"
"    border-color: rgba(22,163,74,0.28);\n"
"    border-left-color: #16a34a;\n"
"  }\n"
"  .cr-cheat-row.is-error {\n"
"    background: rgba(220,38,38,0.07);\n"
"    border-color: rgba(220,38,38,0.28);\n"
"    border-left-color: #dc2626;\n"
"  }\n"
"  .cr-cheat-row.is-mixed {\n"
"    background: linear-gradient(90deg, rgba(217,119,6,0.08), rgba(13,13,16,0.80));\n"
"    border-color: rgba(217,119,6,0.30);\n"
"    border-left-color: #d97706;\n"
"  }\n"
"  .cr-cheat-row.is-unknown      { border-left-color: #78788a; }\n"
"  .cr-cheat-row.is-applying     { @apply opacity-[0.65] pointer-events-none relative overflow-hidden; }\n"
"  .cr-cheat-row.is-applying::after {\n"
"    @apply content-[''] absolute inset-0 pointer-events-none z-[2];\n"
"    background: linear-gradient(90deg, transparent, rgba(234,88,12,0.08), transparent);\n"
"    animation: crScanSweep 0.9s linear infinite;\n"
"  }\n"
"\n"
"  /* Row reveal */\n"
"  #cheatMods.cr-mods-appear .cr-cheat-row              { animation: crRowReveal 0.20s ease both; }\n"
"  #cheatMods.cr-mods-appear .cr-cheat-row:nth-child(2) { animation-delay: 0.04s; }\n"
"  #cheatMods.cr-mods-appear .cr-cheat-row:nth-child(3) { animation-delay: 0.08s; }\n"
"  #cheatMods.cr-mods-appear .cr-cheat-row:nth-child(4) { animation-delay: 0.12s; }\n"
"  #cheatMods.cr-mods-appear .cr-cheat-row:nth-child(5) { animation-delay: 0.16s; }\n"
"  #cheatMods.cr-mods-appear .cr-cheat-row:nth-child(n+6) { animation-delay: 0.20s; }\n"
"\n"
"  .cr-cheat-main  { @apply flex flex-col gap-[3px]; }\n"
"  .cr-cheat-name,\n"
"  .cr-cheat-title { @apply font-sans font-semibold text-[13px] leading-tight; color: #f0f0f4; }\n"
"  .cr-cheat-row.is-on .cr-cheat-name,\n"
"  .cr-cheat-row.is-on .cr-cheat-title   { color: #4ade80; }\n"
"  .cr-cheat-row.is-mixed .cr-cheat-name,\n"
"  .cr-cheat-row.is-mixed .cr-cheat-title { color: #fde68a; }\n"
"\n"
"  .cr-cheat-status-chip {\n"
"    @apply inline-block font-mono text-[9px] font-semibold tracking-[0.06em]\n"
"           px-1.5 py-px rounded leading-[1.6];\n"
"  }\n"
"  .cr-chip-error { background: rgba(220,38,38,0.16); color: #fca5a5; border: 1px solid rgba(220,38,38,0.30); }\n"
"  .cr-chip-mixed { background: rgba(217,119,6,0.16);  color: #fde68a; border: 1px solid rgba(217,119,6,0.30); }\n"
"\n"
"  /* ── Cheat switch ──────────────────────────────────────── */\n"
"  .cr-cheat-switch {\n"
"    @apply relative p-0 border-0 bg-transparent cursor-pointer flex-shrink-0\n"
"           transition-all duration-[180ms];\n"
"    width: 100px; height: 32px;\n"
"    -webkit-tap-highlight-color: transparent;\n"
"    will-change: transform;\n"
"  }\n"
"\n"
"  .cr-cheat-switch-track {\n"
"    @apply relative grid items-center w-full h-full rounded-full overflow-hidden;\n"
"    grid-template-columns: 1fr 1fr;\n"
"    background: #16161d;\n"
"    border: 1px solid rgba(255,255,255,0.12);\n"
"    box-shadow: inset 0 1px 0 rgba(255,255,255,0.04), inset 0 -1px 0 rgba(0,0,0,0.28);\n"
"  }\n"
"\n"
"  .cr-cheat-switch-fill {\n"
"    @apply absolute z-[1] rounded-full;\n"
"    top: 3px; left: 3px;\n"
"    width: calc(50% - 3px); height: calc(100% - 6px);\n"
"    background: linear-gradient(180deg, #dc2626, #991b1b);\n"
"    box-shadow: 0 0 12px rgba(220,38,38,0.28);\n"
"    transform: translateX(0);\n"
"    transition:\n"
"      transform  0.22s cubic-bezier(0.2,0.8,0.2,1),\n"
"      background 0.18s ease,\n"
"      box-shadow 0.18s ease;\n"
"  }\n"
"  .cr-cheat-switch.is-on .cr-cheat-switch-fill {\n"
"    transform: translateX(calc(100% - 3px));\n"
"    background: linear-gradient(180deg, #16a34a, #15803d);\n"
"    box-shadow: 0 0 14px rgba(22,163,74,0.28);\n"
"  }\n"
"  .cr-cheat-switch.is-on .cr-cheat-switch-track {\n"
"    box-shadow:\n"
"      inset 0 1px 0 rgba(255,255,255,0.04),\n"
"      inset 0 -1px 0 rgba(0,0,0,0.28),\n"
"      0 0 12px rgba(22,163,74,0.28);\n"
"  }\n"
"\n"
"  .cr-cheat-switch-label {\n"
"    @apply relative z-[2] font-mono text-[9px] font-semibold tracking-[0.10em]\n"
"           text-center uppercase select-none pointer-events-none transition-colors duration-[180ms];\n"
"    color: rgba(255,255,255,0.30);\n"
"  }\n"
"  .cr-cheat-switch.is-off .cr-cheat-switch-label-off { color: #fff; }\n"
"  .cr-cheat-switch.is-on  .cr-cheat-switch-label-on  { color: #fff; }\n"
"\n"
"  .cr-cheat-switch:hover:not(:disabled):not(.is-applying) { @apply -translate-y-px; }\n"
"  .cr-cheat-switch:hover:not(:disabled):not(.is-applying) .cr-cheat-switch-track {\n"
"    border-color: rgba(255,255,255,0.20);\n"
"  }\n"
"  .cr-cheat-switch:active:not(:disabled):not(.is-applying) { @apply scale-[0.97]; }\n"
"  .cr-cheat-switch:disabled        { @apply opacity-40 cursor-not-allowed; }\n"
"  .cr-cheat-switch:focus-visible   { outline: 2px solid rgba(255,255,255,0.60); outline-offset: 3px; }\n"
"\n"
"  .cr-cheat-switch.is-error .cr-cheat-switch-fill {\n"
"    background: linear-gradient(180deg, #f97316, #7c2d12);\n"
"    box-shadow: 0 0 12px rgba(249,115,22,0.35);\n"
"  }\n"
"  .cr-cheat-switch.is-mixed .cr-cheat-switch-fill {\n"
"    background: linear-gradient(180deg, #d97706, #92400e);\n"
"    box-shadow: 0 0 12px rgba(217,119,6,0.35);\n"
"  }\n"
"\n"
"  .cr-cheat-switch.is-applying {\n"
"    @apply pointer-events-none opacity-75;\n"
"    cursor: progress !important;\n"
"  }\n"
"  .cr-cheat-switch.is-applying .cr-cheat-switch-track::after {\n"
"    @apply content-[''] absolute inset-0 z-[4] pointer-events-none;\n"
"    border-radius: inherit;\n"
"    background: linear-gradient(90deg, transparent, rgba(255,255,255,0.18), transparent);\n"
"    transform: translateX(-100%);\n"
"    animation: crSwitchScan 0.75s linear infinite;\n"
"  }\n"
"\n"
"  /* ── Candidate selector ────────────────────────────────── */\n"
"  #cheatCandidates { @apply my-1.5 mb-2.5; }\n"
"  .cr-cand-list { @apply flex flex-col gap-[5px]; }\n"
"  .cr-cand-row {\n"
"    @apply flex items-center gap-2 px-3 py-2 rounded-[6px] text-xs\n"
"           transition-all duration-150;\n"
"    background: rgba(255,255,255,0.02);\n"
"    border: 1px solid rgba(255,255,255,0.07);\n"
"    border-left: 2px solid transparent;\n"
"    will-change: transform;\n"
"  }\n"
"  .cr-cand-row:hover            { @apply -translate-y-px; }\n"
"  .cr-cand-row.is-selected {\n"
"    border-color: rgba(22,163,74,0.28);\n"
"    border-left-color: #16a34a;\n"
"    background: rgba(22,163,74,0.10);\n"
"  }\n"
"  .cr-cand-row.is-wrong-ver {\n"
"    border-color: rgba(217,119,6,0.25);\n"
"    border-left-color: #d97706;\n"
"    background: rgba(217,119,6,0.05);\n"
"  }\n"
"\n"
"  .cr-cand-fname { @apply flex-1 font-mono overflow-hidden text-ellipsis whitespace-nowrap; color: #b4b4c0; }\n"
"  .cr-cand-meta  { @apply font-mono text-[10px] whitespace-nowrap; color: #78788a; }\n"
"  .cr-cand-badge {\n"
"    @apply font-mono text-[10px] font-semibold tracking-[0.05em] uppercase\n"
"           px-[7px] py-0.5 rounded whitespace-nowrap;\n"
"  }\n"
"  .cr-cand-badge.fmt     { background: rgba(100,130,200,0.16); color: #93c5fd; border: 1px solid rgba(100,130,200,0.22); }\n"
"  .cr-cand-badge.exact   { background: rgba(22,163,74,0.10);   color: #86efac; border: 1px solid rgba(22,163,74,0.28); }\n"
"  .cr-cand-badge.generic { background: rgba(150,150,150,0.14); color: #a1a1aa; border: 1px solid rgba(150,150,150,0.20); }\n"
"  .cr-cand-badge.wrong   { background: rgba(217,119,6,0.16);   color: #fcd34d; border: 1px solid rgba(217,119,6,0.28); }\n"
"  .cr-cand-badge.selected{ background: rgba(22,163,74,0.22);   color: #86efac; border: 1px solid rgba(22,163,74,0.28); }\n"
"  .cr-cand-badge.manual  { background: rgba(130,100,200,0.20); color: #c4b5fd; border: 1px solid rgba(130,100,200,0.30); }\n"
"  .cr-cand-select-btn { @apply text-[11px] px-2.5 py-0.5 flex-shrink-0; }\n"
"  .cr-cand-auto-btn   { @apply text-[11px] px-2.5 py-0.5 flex-shrink-0; background: rgba(130,100,200,0.16); }\n"
"\n"
"  /* ── Toast ─────────────────────────────────────────────── */\n"
"  .toast {\n"
"    @apply fixed right-4 top-4 z-[100000] rounded-[6px] px-3.5 py-2.5\n"
"           font-mono text-xs opacity-0 pointer-events-none;\n"
"    max-width: min(90vw,360px);\n"
"    border: 1px solid rgba(255,255,255,0.12);\n"
"    border-left: 2px solid #ea580c;\n"
"    background: #19191f;\n"
"    color: #f0f0f4;\n"
"  }\n"
"  .toast.show    { animation: crToastIn 0.22s cubic-bezier(0.16,1,0.3,1) forwards; }\n"
"  .toast.info    { border-left-color: #ea580c; background: rgba(234,88,12,0.10); }\n"
"  .toast.success { border-left-color: #16a34a; background: rgba(22,163,74,0.10); color: #bbf7d0; }\n"
"  .toast.warn    { border-left-color: #d97706; background: rgba(217,119,6,0.09); color: #fde68a; }\n"
"  .toast.error   { border-left-color: #dc2626; background: rgba(220,38,38,0.10); color: #fca5a5; }\n"
"\n"
"  /* ── Misc ──────────────────────────────────────────────── */\n"
"  .muted { @apply text-xs; color: #78788a; }\n"
"  .row   { @apply flex gap-2 flex-wrap; }\n"
"\n"
"}\n"
"\n"
"/* ── Keyframe definitions ────────────────────────────────── */\n"
"@layer utilities {\n"
"  @keyframes crPanelDeploy {\n"
"    from { opacity: 0; transform: translateY(16px); }\n"
"    to   { opacity: 1; transform: translateY(0); }\n"
"  }\n"
"  @keyframes crScanSweep {\n"
"    from { transform: translateX(-120%); }\n"
"    to   { transform: translateX(120%); }\n"
"  }\n"
"  @keyframes crSwitchScan {\n"
"    to { transform: translateX(100%); }\n"
"  }\n"
"  @keyframes crStatusTick {\n"
"    0%, 100% { opacity: 1; }\n"
"    50%      { opacity: 0.35; }\n"
"  }\n"
"  @keyframes crToastIn {\n"
"    from { opacity: 0; transform: translateY(-5px) scale(0.97); }\n"
"    to   { opacity: 1; transform: translateY(0) scale(1); }\n"
"  }\n"
"  @keyframes crCardPulse {\n"
"    0%, 100% { box-shadow: none; }\n"
"    50%      { box-shadow: 0 0 22px rgba(234,88,12,0.22); }\n"
"  }\n"
"  @keyframes crVertScan {\n"
"    0%   { top: -4px; opacity: 1; }\n"
"    100% { top: 100%; opacity: 0.4; }\n"
"  }\n"
"  @keyframes crRowReveal {\n"
"    from { opacity: 0; transform: translateY(6px); }\n"
"    to   { opacity: 1; transform: translateY(0); }\n"
"  }\n"
"}\n"
"\n"
"/* ── Responsive ──────────────────────────────────────────── */\n"
"@media (max-width: 1200px) {\n"
"  .cr-app-shell { grid-template-columns: 1fr; }\n"
"  .side         { order: 2; }\n"
"}\n"
"@media (max-width: 768px) {\n"
"  body               { padding: 12px; }\n"
"  .toolbar           { grid-template-columns: 1fr; }\n"
"  .tabs              { overflow: auto; }\n"
"  .modal-footer      { justify-content: stretch; }\n"
"  .modal-footer .btn { flex: 1 1 160px; }\n"
"  .topbar            { padding: 12px; }\n"
"}\n"
"@media (max-width: 640px) {\n"
"  .cr-support-button,\n"
"  .cr-discord-button,\n"
"  .cr-x-button       { padding: 0; width: 36px; min-height: 36px; }\n"
"  .cr-support-label,\n"
"  .cr-discord-label,\n"
"  .cr-x-label        { display: none; }\n"
"}\n"
